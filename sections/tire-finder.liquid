{% schema %}
{
  "name": "Buscador de Neumáticos",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Encuentra tu neumático"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Texto de ayuda",
      "default": "Ingresa la medida que aparece en el costado de tu neumático."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Ver neumáticos"
    },
    {
      "type": "checkbox",
      "id": "require_metric_profile",
      "label": "Exigir perfil en medidas métricas",
      "default": false
    },

    {
      "type": "collection",
      "id": "target_collection",
      "label": "Colección de Destino",
      "info": "Colección donde están tus neumáticos (ej: 'Todos los neumáticos')"
    },
    {
      "type": "text",
      "id": "storefront_token",
      "label": "Storefront Access Token",
      "info": "Tu token público de la Storefront API"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de acento (botón)",
      "default": "#FF6600"
    }
  ],
  "presets": [
    {
      "name": "Buscador de Neumáticos"
    }
  ]
}
{% endschema %}

{%- assign tire_finder_id = 'tire-finder-' | append: section.id -%}
{%- assign tire_finder_ancho_id = tire_finder_id | append: '-ancho' -%}
{%- assign tire_finder_aspecto_id = tire_finder_id | append: '-aspecto' -%}
{%- assign tire_finder_aro_id = tire_finder_id | append: '-aro' -%}
{%- assign tire_finder_use_id = tire_finder_id | append: '-uso' -%}
{%- assign tire_finder_button_id = tire_finder_id | append: '-buscar' -%}
{%- assign tire_finder_instructions_id = tire_finder_id | append: '-instrucciones' -%}
{%- assign tire_finder_status_id = tire_finder_id | append: '-estado' -%}
{%- assign tire_finder_updates_id = tire_finder_id | append: '-actualizaciones' -%}
{%- assign tire_usage_filter = nil -%}
{%- for filter in collection.filters -%}
  {%- assign tire_filter_label = filter.label | downcase -%}
  {%- if tire_filter_label contains 'uso' -%}
    {%- assign tire_usage_filter = filter -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

<div class="pf-wrapper{% if request.page_type == 'collection' %} pf-wrapper--landing{% endif %}" id="{{ tire_finder_id }}" data-tire-finder aria-busy="true">
  <div class="pf-inner page-width">
    <div class="pf-accent" aria-hidden="true"></div>
    <div class="pf-header">
      <span class="pf-header-icon" aria-hidden="true">⌕</span>
      <div>
        <h2 class="pf-title">{{ section.settings.title }}</h2>
        {%- if section.settings.help_text != blank -%}
          <p class="pf-help">{{ section.settings.help_text | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    <p id="{{ tire_finder_instructions_id }}" class="pf-sr-only">
      {%- if section.settings.require_metric_profile -%}
        Selecciona la medida del neumático. El perfil es obligatorio para medidas métricas y puede quedar vacío en medidas americanas.
      {%- else -%}
        Selecciona la medida del neumático. El aro es obligatorio; el ancho y el perfil son opcionales.
      {%- endif -%}
      Las opciones disponibles se actualizan según cada selección.
    </p>

    <div class="pf-card" role="search" aria-label="Buscar neumáticos por medida" aria-describedby="{{ tire_finder_instructions_id }}">
      <!-- Paso 1: Ancho -->
      <div class="pf-step" data-step="1">
        <div class="pf-step-number" aria-hidden="true">1</div>
        <div class="pf-field">
          <label class="pf-label" for="{{ tire_finder_ancho_id }}">Ancho</label>
          <div class="pf-select-wrap">
            <select id="{{ tire_finder_ancho_id }}" class="pf-select" aria-describedby="{{ tire_finder_instructions_id }}" aria-required="false" disabled>
              <option value="">Cargando...</option>
            </select>
            <span class="pf-select-icon" aria-hidden="true">▾</span>
          </div>
        </div>
      </div>

      <!-- Paso 2: Perfil -->
      <div class="pf-step" data-step="2">
        <div class="pf-step-number" aria-hidden="true">2</div>
        <div class="pf-field">
          <label class="pf-label" for="{{ tire_finder_aspecto_id }}">Perfil{% unless section.settings.require_metric_profile %} <span class="pf-optional">(opcional)</span>{% endunless %}</label>
          <div class="pf-select-wrap">
            <select id="{{ tire_finder_aspecto_id }}" class="pf-select" aria-describedby="{{ tire_finder_instructions_id }}" aria-required="false" disabled>
              <option value="">— Cualquier perfil —</option>
            </select>
            <span class="pf-select-icon" aria-hidden="true">▾</span>
          </div>
        </div>
      </div>

      <!-- Paso 3: Aro (diámetro) -->
      <div class="pf-step" data-step="3">
        <div class="pf-step-number" aria-hidden="true">3</div>
        <div class="pf-field">
          <label class="pf-label" for="{{ tire_finder_aro_id }}">Aro</label>
          <div class="pf-select-wrap">
            <select id="{{ tire_finder_aro_id }}" class="pf-select" aria-describedby="{{ tire_finder_instructions_id }}" aria-required="true" disabled>
              <option value="">— Selecciona Aro —</option>
            </select>
            <span class="pf-select-icon" aria-hidden="true">▾</span>
          </div>
        </div>
      </div>

      {%- if tire_usage_filter != nil -%}
        <div class="pf-step" data-step="4">
          <div class="pf-step-number" aria-hidden="true">4</div>
          <div class="pf-field">
            <label class="pf-label" for="{{ tire_finder_use_id }}">Tipo de uso <span class="pf-optional">(opcional)</span></label>
            <div class="pf-select-wrap">
              <select id="{{ tire_finder_use_id }}" class="pf-select" data-param-name="{{ tire_usage_filter.param_name | escape }}">
                <option value="">— Todos los usos —</option>
                {%- for value in tire_usage_filter.values -%}
                  <option value="{{ value.value | escape }}"{% if value.active %} selected{% endif %}>{{ value.label | escape }}</option>
                {%- endfor -%}
              </select>
              <span class="pf-select-icon" aria-hidden="true">▾</span>
            </div>
          </div>
        </div>
      {%- endif -%}

      <!-- Botón de búsqueda -->
      <div class="pf-step pf-step--action">
        <button id="{{ tire_finder_button_id }}" class="pf-btn" type="button" aria-describedby="{{ tire_finder_instructions_id }}" disabled>
          <span class="pf-btn-text">{{ section.settings.button_label | escape }}</span>
          <span class="pf-btn-icon" aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- Estado de carga / error -->
    <div id="{{ tire_finder_status_id }}" class="pf-status" role="status" aria-live="polite" aria-atomic="true" style="display:none;">
      <span class="pf-status-icon" aria-hidden="true"></span>
      <span class="pf-status-message"></span>
      <button class="pf-status-clear" type="button">limpiar filtros</button>
    </div>
    <div id="{{ tire_finder_updates_id }}" class="pf-sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

  </div>
</div>

<style>
  :root {
    --pf-accent: {{ section.settings.accent_color }};
    --pf-bg: #FFFFFF;
    --pf-card: #FFFFFF;
    --pf-border: #D6D6D6;
    --pf-input-bg: #FFFFFF;
    --pf-text: #1C1C1C;
    --pf-muted: #666666;
    --pf-step-size: 28px;
    --pf-radius: 0;
    --pf-transition: 0.25s ease;
  }

  .pf-wrapper {
    background: var(--pf-bg);
    margin-block: 20px;
    padding: 0 0 54px;
    font-family: 'Arial Narrow', Arial, sans-serif;
    border-top: none;
    border-bottom: none;
  }

  .pf-accent {
    display: none;
  }

  .pf-inner {
    max-width: 1520px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .pf-sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .pf-header {
    text-align: left;
    margin-bottom: 26px;
  }
  .pf-title {
    color: var(--pf-text);
    font-size: clamp(2.4rem, 1.7vw, 3rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.98;
    margin: 0;
    text-transform: uppercase;
  }
  .pf-title::after {
    content: none;
  }
  .pf-help {
    color: var(--pf-muted);
    font-size: 1.4rem;
    line-height: 1.5;
    margin: 10px 0 0;
  }

  .pf-card {
    background: var(--pf-card);
    border: none;
    border-radius: var(--pf-radius);
    padding: 0;
    display: grid;
    grid-template-columns: minmax(240px, 1fr) minmax(240px, 1fr) minmax(240px, 1fr) 250px;
    gap: 8px;
    align-items: end;
  }

  .pf-step {
    position: relative;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    align-items: end;
    gap: 10px;
    min-width: 0;
  }
  .pf-step--action {
    display: block;
    align-items: end;
  }

  .pf-step-number {
    width: var(--pf-step-size);
    height: var(--pf-step-size);
    min-width: var(--pf-step-size);
    background: #e9e9eb;
    color: var(--pf-muted);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 900;
    margin-top: 0;
    margin-bottom: 4px;
    transition: background var(--pf-transition), color var(--pf-transition);
  }

  .pf-step.is-active .pf-step-number {
    background: var(--pf-accent);
    color: #fff;
  }

  .pf-field {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pf-label {
    color: var(--pf-text);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }
  .pf-optional {
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.68rem;
    opacity: 0.7;
  }

  .pf-select-wrap {
    position: relative;
  }
  .pf-select {
    width: 100%;
    height: 40px;
    padding: 0 34px 0 14px;
    background: var(--pf-input-bg);
    border: 1px solid var(--pf-border);
    border-radius: 0;
    color: var(--pf-text);
    font-size: 1.4rem;
    font-weight: 400;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    transition: border-color var(--pf-transition), box-shadow var(--pf-transition);
    outline: none;
  }
  .pf-select:focus {
    border-color: var(--pf-accent);
    box-shadow: 0 0 0 1px var(--pf-accent);
  }
  .pf-select:focus-visible,
  .pf-btn:focus-visible {
    outline: 2px solid var(--pf-accent);
    outline-offset: 2px;
  }
  .pf-select:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .pf-select option {
    background: #FFFFFF;
    color: var(--pf-text);
  }
  .pf-select-icon {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--pf-text);
    pointer-events: none;
    font-size: 0.85rem;
  }

  .pf-btn {
    width: 100%;
    height: 40px;
    padding: 0 20px;
    background: var(--pf-accent);
    color: #fff;
    border: none;
    border-radius: 0;
    font-size: 1.2rem;
    font-weight: 900;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: opacity var(--pf-transition), transform var(--pf-transition);
  }
  .pf-btn:hover:not(:disabled) {
    opacity: 0.88;
    transform: translateY(-1px);
  }
  .pf-btn:active:not(:disabled) {
    transform: translateY(0);
  }
  .pf-btn:disabled {
    background: var(--pf-accent);
    color: #fff;
    cursor: not-allowed;
    transform: none;
    border: 1px solid var(--pf-accent);
    opacity: 1;
  }
  .pf-btn-icon {
    font-size: 1.1rem;
    transition: transform var(--pf-transition);
  }
  .pf-btn:hover:not(:disabled) .pf-btn-icon {
    transform: translateX(4px);
  }

  .pf-status {
    text-align: left;
    margin-top: 16px;
    font-size: 1.3rem;
    color: var(--pf-muted);
  }
  .pf-status.is-error {
    color: #FF6600;
  }

  .pf-status-icon,
  .pf-status-clear {
    display: none;
  }

  .pf-wrapper--landing {
    background: transparent;
    margin: 0;
    padding: 0;
    position: relative;
    z-index: 3;
  }

  .pf-wrapper--landing .pf-inner {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 22px 55px rgba(18, 18, 18, .16);
    margin-bottom: -5.2rem;
    max-width: min(1440px, calc(100% - 3rem));
    overflow: hidden;
    padding: 0 2.8rem 1.2rem;
    transform: translateY(-5.2rem);
  }

  .pf-wrapper--landing .pf-accent {
    background: var(--pf-accent);
    display: block;
    height: 7px;
    margin: 0 -2.8rem 2.6rem;
  }

  .pf-wrapper--landing .pf-header {
    align-items: center;
    display: flex;
    gap: 1.4rem;
    margin-bottom: 2.4rem;
  }

  .pf-wrapper--landing .pf-header-icon {
    align-items: center;
    background: #17191b;
    border-radius: 9px;
    color: var(--pf-accent);
    display: flex;
    flex: 0 0 46px;
    font-family: Arial, sans-serif;
    font-size: 2.8rem;
    font-weight: 700;
    height: 46px;
    justify-content: center;
    transform: rotate(-20deg);
  }

  .pf-wrapper--landing .pf-title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.9rem, 1.6vw, 2.4rem);
  }

  .pf-wrapper--landing .pf-help {
    margin-top: .5rem;
  }

  .pf-wrapper--landing .pf-card {
    grid-template-columns: repeat(4, minmax(150px, 1fr)) minmax(190px, .9fr);
    gap: 1.2rem;
  }

  .pf-wrapper--landing .pf-step {
    display: block;
  }

  .pf-wrapper--landing .pf-step-number {
    display: none;
  }

  .pf-wrapper--landing .pf-label {
    font-family: var(--font-heading-family);
    font-size: 1.15rem;
  }

  .pf-wrapper--landing .pf-select,
  .pf-wrapper--landing .pf-btn {
    border-radius: 7px;
    height: 48px;
  }

  .pf-wrapper--landing .pf-select {
    background: #f2f3f5;
    border-color: transparent;
    font-family: var(--font-body-family);
    font-size: 1.45rem;
    font-weight: 700;
  }

  .pf-wrapper--landing .pf-select:hover:not(:disabled) {
    border-color: #d3d5d8;
  }

  .pf-wrapper--landing .pf-btn {
    box-shadow: 0 8px 18px rgba(255, 102, 0, .2);
    font-family: var(--font-heading-family);
    font-size: 1.45rem;
  }

  .pf-wrapper--landing .pf-btn:disabled {
    opacity: .48;
  }

  .pf-wrapper--landing .pf-status {
    align-items: center;
    background: #eef4ff;
    border: 1px solid #dce7f7;
    border-radius: 8px;
    color: #26384f;
    display: flex;
    font-size: 1.5rem;
    gap: .8rem;
    line-height: 1.45;
    margin-top: 1.2rem;
    min-height: 49px;
    padding: .6rem .8rem;
  }

  .pf-wrapper--landing .pf-status-icon {
    align-items: center;
    background: var(--pf-accent);
    border-radius: 50%;
    color: #fff;
    display: flex;
    flex: 0 0 22px;
    font-size: 1.1rem;
    font-weight: 900;
    height: 22px;
    justify-content: center;
  }

  .pf-wrapper--landing .pf-status-message {
    flex: 1;
    font-weight: 700;
  }

  .pf-wrapper--landing .pf-status-measurement {
    font-weight: 900;
  }

  .pf-wrapper--landing .pf-status-clear {
    background: #fff;
    border: 1px solid #d6d9de;
    border-radius: 5px;
    color: #222;
    cursor: pointer;
    display: none;
    font-family: var(--font-heading-family);
    font-size: 1.3rem;
    font-weight: 800;
    min-height: 30px;
    padding: .5rem .9rem;
    text-transform: none;
  }

  .pf-wrapper--landing .pf-status.has-clear .pf-status-clear { display: inline-flex; }
  .pf-wrapper--landing .pf-status.is-warning { background: #fff5da; border-color: #f1d690; color: #614900; }
  .pf-wrapper--landing .pf-status.is-warning .pf-status-icon { background: #c78000; }
  .pf-wrapper--landing .pf-status.is-error { background: #fff0ed; border-color: #f2c7bf; color: #8f2a1b; }
  .pf-wrapper--landing .pf-status.is-error .pf-status-icon { background: #b73a26; }
  .pf-wrapper--landing .pf-status.is-empty { background: #f1f2f3; border-color: #d9dadd; color: #3c4145; }
  .pf-wrapper--landing .pf-status.is-empty .pf-status-icon { background: #656a6e; }

  @media (max-width: 960px) {
    .pf-card {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .pf-step--action {
      grid-column: 1 / -1;
    }
    .pf-wrapper--landing .pf-card {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pf-wrapper--landing .pf-step--action {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .pf-wrapper {
      padding: 0 0 34px;
    }
    .pf-title {
      font-size: 2.4rem;
    }
    .pf-card {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .pf-wrapper--landing { padding-bottom: 0; }
    .pf-wrapper--landing .pf-inner {
      border-radius: 9px;
      margin-bottom: -3.8rem;
      max-width: calc(100% - 2.4rem);
      padding: 0 1.6rem 1.2rem;
      transform: translateY(-3.8rem);
    }
    .pf-wrapper--landing .pf-accent { margin: 0 -1.6rem 2rem; }
    .pf-wrapper--landing .pf-header { align-items: flex-start; }
    .pf-wrapper--landing .pf-header-icon { flex-basis: 40px; height: 40px; }
    .pf-wrapper--landing .pf-card { grid-template-columns: 1fr; }
    .pf-wrapper--landing .pf-status { align-items: flex-start; flex-wrap: wrap; }
    .pf-wrapper--landing .pf-status-clear { margin-left: 4rem; }
    .pf-select,
    .pf-btn {
      height: 42px;
    }
  }
</style>

<script>
(function() {
  'use strict';

  async function initTireFinder() {
    const finderEl = document.getElementById('{{ tire_finder_id }}');
    if (!finderEl || finderEl.dataset.initialized === 'true') return;
    finderEl.dataset.initialized = 'true';

    // ─────────────────────────────────────────────
    // CONFIGURACIÓN
    // ─────────────────────────────────────────────
    const STOREFRONT_TOKEN = "{{ section.settings.storefront_token }}";
    const API_URL          = "/api/2026-07/graphql.json";
    const COLLECTION_HANDLE = "{{ collections[section.settings.target_collection].handle | default: 'all' }}";
    const COLLECTION_URL    = "{{ collections[section.settings.target_collection].url | default: '/collections/all' }}";
    const FINDER_SOURCE     = {{ request.page_type | json }};
    const RESULTS_COUNT     = {{ collection.products_count | default: -1 | json }};
    const REQUIRE_METRIC_PROFILE = {{ section.settings.require_metric_profile | json }};

    // Namespace y keys de los metacampos en los productos
    // Ajusta el namespace si no es "custom"
    const NAMESPACE_ANCHO   = "custom";   const KEY_ANCHO   = "ancho";
    const NAMESPACE_ASPECTO = "custom";   const KEY_ASPECTO = "aspecto";
    const NAMESPACE_ARO     = "custom";   const KEY_ARO     = "di_metro";  // custom.di_metro

    // ─────────────────────────────────────────────
    // ELEMENTOS DEL DOM
    // ─────────────────────────────────────────────
    const selectAncho   = finderEl.querySelector('#{{ tire_finder_ancho_id }}');
    const selectAspecto = finderEl.querySelector('#{{ tire_finder_aspecto_id }}');
    const selectAro     = finderEl.querySelector('#{{ tire_finder_aro_id }}');
    const selectUse     = finderEl.querySelector('#{{ tire_finder_use_id }}');
    const btnSearch     = finderEl.querySelector('#{{ tire_finder_button_id }}');
    const statusEl      = finderEl.querySelector('#{{ tire_finder_status_id }}');
    const statusIconEl  = statusEl.querySelector('.pf-status-icon');
    const statusMessageEl = statusEl.querySelector('.pf-status-message');
    const statusClearEl = statusEl.querySelector('.pf-status-clear');
    const updatesEl     = finderEl.querySelector('#{{ tire_finder_updates_id }}');
    const steps         = finderEl.querySelectorAll('.pf-step[data-step]');
    const USAGE_PARAM_NAME = selectUse?.dataset.paramName || '';

    // ─────────────────────────────────────────────
    // ESTADO LOCAL
    // Lista de combinaciones únicas {ancho, aspecto, aro}
    // extraídas de todos los productos de la colección
    // ─────────────────────────────────────────────
    let allCombinations = [];

    // ─────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────
    function showStatus(msg, type = 'info', showClear = false) {
      const iconByType = { info: '✓', warning: '!', error: '!', empty: '–' };
      statusMessageEl.textContent = msg;
      statusIconEl.textContent = iconByType[type] || '✓';
      statusEl.className = `pf-status${type === 'info' ? '' : ` is-${type}`}${showClear ? ' has-clear' : ''}`;
      statusEl.style.display = 'flex';
    }

    function showMeasurementStatus(measurement, availability) {
      const measurementEl = document.createElement('strong');
      measurementEl.className = 'pf-status-measurement';
      measurementEl.textContent = measurement;

      showStatus('', 'info', true);
      statusMessageEl.append(
        'medida seleccionada: ',
        measurementEl,
        `. mostrando ${availability}.`
      );
    }

    function hideStatus() { statusEl.style.display = 'none'; }

    function publishEvent(name, data) {
      if (!window.Shopify?.analytics?.publish) return;
      try {
        const result = window.Shopify.analytics.publish(name, data);
        if (result?.catch) result.catch(() => {});
      } catch (error) {
        console.debug('[Tire Finder] Analytics event not published.', error);
      }
    }

    function setLoading(isLoading) {
      finderEl.setAttribute('aria-busy', String(isLoading));
    }

    function announceOptions(changedSelect) {
      if (!changedSelect) return;

      const fieldNames = {
        ancho: 'el ancho',
        aspecto: 'el perfil',
        aro: 'el aro'
      };
      const optionCount = (select) => Math.max(0, select.options.length - 1);

      updatesEl.textContent = `Opciones actualizadas después de cambiar ${fieldNames[changedSelect]}. ${optionCount(selectAncho)} opciones de ancho, ${optionCount(selectAspecto)} opciones de perfil y ${optionCount(selectAro)} opciones de aro disponibles.`;
    }

    function setStepActive() {
      steps.forEach(s => {
        const n = s.dataset.step;
        const isActive =
          (n === '1' && selectAncho.value) ||
          (n === '2' && selectAspecto.value) ||
          (n === '3' && selectAro.value) ||
          (n === '4' && selectUse?.value);

        s.classList.toggle('is-active', Boolean(isActive));
      });
    }

    function resetSelect(el, placeholder) {
      el.innerHTML = `<option value="">${placeholder}</option>`;
      el.disabled = true;
    }

    function sortNumeric(arr) {
      return arr.slice().sort((a, b) => parseFloat(a) - parseFloat(b));
    }

    function formatAnchoValue(value) {
      const num = Number(String(value).replace(',', '.'));
      if (!Number.isFinite(num)) return value;
      if (num >= 20) return String(Math.round(num));
      if (num < 20) return num.toFixed(2);
      return value;
    }

    function requiresProfile(value) {
      if (!REQUIRE_METRIC_PROFILE) return false;
      const num = Number(String(value).replace(',', '.'));
      return Number.isFinite(num) && num >= 20;
    }

    function getToken() {
      if (STOREFRONT_TOKEN && STOREFRONT_TOKEN.trim().length > 10) return STOREFRONT_TOKEN.trim();
      if (window.Shopify && window.Shopify.storefrontAccessToken) return window.Shopify.storefrontAccessToken;
      return null;
    }

    // ─────────────────────────────────────────────
    // GRAPHQL — Obtiene todos los productos de la colección
    // con sus metacampos de ancho, aspecto y aro (di_metro)
    // ─────────────────────────────────────────────
    async function fetchAllProducts(token) {
      let allProducts = [];
      let hasNextPage = true;
      let cursor = null;

      while (hasNextPage) {
        const afterClause = cursor ? `, after: "${cursor}"` : "";

        const query = `
          {
            collection(handle: "${COLLECTION_HANDLE}") {
              products(first: 250${afterClause}) {
                pageInfo {
                  hasNextPage
                  endCursor
                }
                nodes {
                  id
                  title
                  ancho: metafield(namespace: "${NAMESPACE_ANCHO}", key: "${KEY_ANCHO}") {
                    value
                  }
                  aspecto: metafield(namespace: "${NAMESPACE_ASPECTO}", key: "${KEY_ASPECTO}") {
                    value
                  }
                  aro: metafield(namespace: "${NAMESPACE_ARO}", key: "${KEY_ARO}") {
                    value
                  }
                }
              }
            }
          }
        `;

        const response = await fetch(API_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Shopify-Storefront-Access-Token': token
          },
          body: JSON.stringify({ query })
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        const json = await response.json();

        if (json.errors) {
          throw new Error(json.errors.map(e => e.message).join(', '));
        }

        if (!json.data.collection) {
          throw new Error('Colección no encontrada. Verifica el handle en la configuración.');
        }

        const productsData = json.data.collection.products;
        allProducts = allProducts.concat(productsData.nodes);
        hasNextPage = productsData.pageInfo.hasNextPage;
        cursor = productsData.pageInfo.endCursor;
      }

      return allProducts;
    }

    // ─────────────────────────────────────────────
    // PROCESAR PRODUCTOS → Combinaciones únicas
    // Acepta productos con solo ancho + aro (medida americana)
    // o con los 3 campos (medida métrica)
    // ─────────────────────────────────────────────
    function parseCombinations(products) {
      const seen = new Set();
      const combinations = [];

      products.forEach(p => {
        const ancho   = p.ancho?.value?.trim()   || "";
        const aspecto = p.aspecto?.value?.trim() || ""; // puede estar vacío
        const aro     = p.aro?.value?.trim()     || "";

        // Mínimo requerido: aro
        if (!aro) return;

        const key = `${ancho}|${aspecto}|${aro}`;
        if (!seen.has(key)) {
          seen.add(key);
          combinations.push({ ancho, aspecto, aro });
        }
      });

      return combinations;
    }

    // ─────────────────────────────────────────────
    // REPOBLAR SELECTS — lógica inteligente:
    // Cada select muestra solo las opciones compatibles
    // con lo que hay seleccionado en los OTROS dos,
    // pero nunca se deshabilita. El valor actual se
    // conserva si sigue siendo válido.
    // ─────────────────────────────────────────────
    function repopulate(changedSelect) {
      const ancho   = selectAncho.value;
      const aspecto = selectAspecto.value;
      const aro     = selectAro.value;

      // Filtrar combinaciones según los campos que NO cambiaron
      function filtered(ignoring) {
        return allCombinations.filter(c => {
          const matchAncho   = (ignoring === 'ancho'   || !ancho   || c.ancho === ancho);
          const matchAspecto = (ignoring === 'aspecto' || !aspecto || c.aspecto === aspecto);
          const matchAro     = (ignoring === 'aro'     || !aro     || c.aro === aro);
          return matchAncho && matchAspecto && matchAro;
        });
      }

      // Rebuilds a select preserving current value if still valid
      function rebuild(el, values, placeholder, formatter) {
        const current = el.value;
        el.innerHTML = `<option value="">${placeholder}</option>`;
        values.forEach(val => {
          const opt = document.createElement('option');
          opt.value = val;
          opt.textContent = formatter ? formatter(val) : val;
          el.appendChild(opt);
        });
        el.disabled = values.length === 0;
        // Restore previous selection if still available
        if (values.includes(current)) el.value = current;
      }

      // Recalcular cada select ignorando a sí mismo
      if (changedSelect !== 'ancho') {
        const src = changedSelect === null ? allCombinations : filtered('ancho');
        const anchos = sortNumeric([...new Set(src.map(c => c.ancho).filter(Boolean))]);
        rebuild(selectAncho, anchos, '— Selecciona Ancho —', formatAnchoValue);
      }

      if (changedSelect !== 'aspecto') {
        const src = changedSelect === null ? allCombinations : filtered('aspecto');
        const aspectos = sortNumeric([...new Set(src.map(c => c.aspecto).filter(Boolean))]);
        const profilePlaceholder = requiresProfile(ancho) ? '— Selecciona Perfil —' : '— Cualquier perfil —';
        rebuild(selectAspecto, aspectos, profilePlaceholder);
      }

      if (changedSelect !== 'aro') {
        const src = changedSelect === null ? allCombinations : filtered('aro');
        const aros = sortNumeric([...new Set(src.map(c => c.aro))]);
        rebuild(selectAro, aros, '— Selecciona Aro —');
      }

      // Botón e indicadores visuales
      const r = selectAro.value;
      btnSearch.disabled = !r || (requiresProfile(selectAncho.value) && !selectAspecto.value);
      selectAspecto.setAttribute('aria-required', String(requiresProfile(selectAncho.value)));
      setStepActive();
      announceOptions(changedSelect);
    }

    // Carga inicial — todos los selects con todos sus valores
    function populateAll() {
      repopulate(null); // null = no se está cambiando ninguno, mostrar todo
    }

    function selectedMeasurement() {
      const ancho = selectAncho.value;
      const aspecto = selectAspecto.value;
      const aro = selectAro.value;
      if (!aro) return '';
      if (ancho && aspecto) return `${formatAnchoValue(ancho)}/${aspecto}-${aro}`;
      if (ancho) return `${formatAnchoValue(ancho)}-${aro}`;
      return aro;
    }

    function restoreSelectionFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const selected = {
        ancho: params.get(`filter.p.m.${NAMESPACE_ANCHO}.${KEY_ANCHO}`) || '',
        aspecto: params.get(`filter.p.m.${NAMESPACE_ASPECTO}.${KEY_ASPECTO}`) || '',
        aro: params.get(`filter.p.m.${NAMESPACE_ARO}.${KEY_ARO}`) || '',
        uso: USAGE_PARAM_NAME ? params.get(USAGE_PARAM_NAME) || '' : ''
      };

      if (!selected.ancho && !selected.aspecto && !selected.aro && !selected.uso) return false;

      if ([...selectAncho.options].some(option => option.value === selected.ancho)) selectAncho.value = selected.ancho;
      if ([...selectAspecto.options].some(option => option.value === selected.aspecto)) selectAspecto.value = selected.aspecto;
      if ([...selectAro.options].some(option => option.value === selected.aro)) selectAro.value = selected.aro;
      if (selectUse && [...selectUse.options].some(option => option.value === selected.uso)) selectUse.value = selected.uso;
      repopulate(null);

      if (RESULTS_COUNT === 0) {
        showStatus('No encontramos coincidencias publicadas para esta medida con los filtros seleccionados. Puedes cambiar la medida o seguir navegando por el catálogo.', 'empty', true);
      } else {
        const measurement = selectedMeasurement();
        if (measurement) {
          const availability = RESULTS_COUNT === 1
            ? '1 neumático disponible'
            : RESULTS_COUNT > 1
              ? `${RESULTS_COUNT} neumáticos disponibles`
              : 'neumáticos disponibles';
          showMeasurementStatus(measurement, availability);
        }
      }

      return true;
    }

    // ─────────────────────────────────────────────
    // INICIALIZAR
    // ─────────────────────────────────────────────
    async function init() {
      const token = getToken();

      if (!token) {
        showStatus('No pudimos cargar el buscador. Intenta nuevamente; la colección y sus filtros siguen disponibles.', 'error');
        selectAncho.innerHTML = '<option value="">Token requerido</option>';
        setLoading(false);
        return;
      }

      showStatus('Cargando medidas disponibles...', 'info');

      try {
        const products = await fetchAllProducts(token);
        allCombinations = parseCombinations(products);

        if (allCombinations.length === 0) {
          showStatus('No pudimos cargar el buscador. Intenta nuevamente; la colección y sus filtros siguen disponibles.', 'error');
          return;
        }

        hideStatus();
        populateAll();
        const restoredSelection = restoreSelectionFromUrl();
        if (!restoredSelection) {
          hideStatus();
        }

      } catch (err) {
        console.error('[Tire Finder] Error:', err);
        showStatus('No pudimos cargar el buscador. Intenta nuevamente; la colección y sus filtros siguen disponibles.', 'error');
        selectAncho.innerHTML = '<option value="">Error de carga</option>';
      } finally {
        setLoading(false);
      }
    }

    // ─────────────────────────────────────────────
    // EVENT LISTENERS — cada select actualiza los otros
    // ─────────────────────────────────────────────
    function handleSelectionChange(changedSelect) {
      repopulate(changedSelect);
      if (REQUIRE_METRIC_PROFILE && selectAncho.value && ((requiresProfile(selectAncho.value) && !selectAspecto.value) || !selectAro.value)) {
        showStatus('Completa perfil y aro para buscar la medida correcta.', 'warning');
      } else {
        hideStatus();
      }
    }

    selectAncho.addEventListener('change',   () => handleSelectionChange('ancho'));
    selectAspecto.addEventListener('change', () => handleSelectionChange('aspecto'));
    selectAro.addEventListener('change',     () => handleSelectionChange('aro'));
    selectUse?.addEventListener('change', () => setStepActive());

    statusClearEl.addEventListener('click', () => {
      const params = new URLSearchParams();
      const currentParams = new URLSearchParams(window.location.search);
      ['preview_theme_id', 'view'].forEach(paramName => {
        const value = currentParams.get(paramName);
        if (value) params.append(paramName, value);
      });
      const query = params.toString();
      window.location.href = `${COLLECTION_URL}${query ? `?${query}` : ''}`;
    });

    // ─────────────────────────────────────────────
    // BÚSQUEDA — aplica solo los filtros con valor
    // Aro obligatorio; ancho y perfil opcionales
    // ─────────────────────────────────────────────
    btnSearch.addEventListener('click', () => {
      const ancho   = selectAncho.value;
      const aspecto = selectAspecto.value;
      const aro     = selectAro.value;
      const uso     = selectUse?.value || '';

      if (!aro || (requiresProfile(ancho) && !aspecto)) {
        showStatus('Completa perfil y aro para buscar la medida correcta.', 'warning');
        publishEvent('bikerz:tire_finder_incomplete', {
          source: FINDER_SOURCE,
          collection_handle: COLLECTION_HANDLE
        });
        return;
      }

      // Filtros de metacampos: ?filter.p.m.NAMESPACE.KEY=VALOR
      // Solo se añaden ancho y perfil si el usuario los seleccionó
      const params = new URLSearchParams();
      if (ancho) {
        params.append(`filter.p.m.${NAMESPACE_ANCHO}.${KEY_ANCHO}`, ancho);
      }
      if (aspecto) {
        params.append(`filter.p.m.${NAMESPACE_ASPECTO}.${KEY_ASPECTO}`, aspecto);
      }
      params.append(`filter.p.m.${NAMESPACE_ARO}.${KEY_ARO}`, aro);
      if (uso && USAGE_PARAM_NAME) {
        params.append(USAGE_PARAM_NAME, uso);
      }

      // Conserva el contexto técnico cuando la landing se revisa en un theme de vista previa.
      const currentParams = new URLSearchParams(window.location.search);
      ['preview_theme_id', 'view'].forEach(paramName => {
        const value = currentParams.get(paramName);
        if (value) params.append(paramName, value);
      });

      publishEvent('bikerz:tire_finder_search', {
        source: FINDER_SOURCE,
        collection_handle: COLLECTION_HANDLE,
        ancho,
        perfil: aspecto,
        aro,
        uso
      });

      window.location.href = `${COLLECTION_URL}?${params.toString()}`;
    });

    // ─────────────────────────────────────────────
    // ARRANCAR
    // ─────────────────────────────────────────────
    init();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTireFinder, { once: true });
  } else {
    initTireFinder();
  }

})();
</script>
