{% schema %}
{
  "name": "Buscador de Neumáticos",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Encuentra tu neumático"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Texto de ayuda",
      "default": "Ingresa la medida que aparece en el costado de tu neumático."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Ver neumáticos"
    },
    {
      "type": "checkbox",
      "id": "require_metric_profile",
      "label": "Exigir perfil en medidas métricas",
      "default": false
    },

    {
      "type": "collection",
      "id": "target_collection",
      "label": "Colección de Destino",
      "info": "Colección donde están tus neumáticos (ej: 'Todos los neumáticos')"
    },
    {
      "type": "text",
      "id": "storefront_token",
      "label": "Storefront Access Token",
      "info": "Tu token público de la Storefront API"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de acento (botón)",
      "default": "#FF6600"
    }
  ],
  "presets": [
    {
      "name": "Buscador de Neumáticos"
    }
  ]
}
{% endschema %}

{%- assign tire_finder_id = 'tire-finder-' | append: section.id -%}
{%- assign tire_finder_ancho_id = tire_finder_id | append: '-ancho' -%}
{%- assign tire_finder_aspecto_id = tire_finder_id | append: '-aspecto' -%}
{%- assign tire_finder_aro_id = tire_finder_id | append: '-aro' -%}
{%- assign tire_finder_use_id = tire_finder_id | append: '-uso' -%}
{%- assign tire_finder_button_id = tire_finder_id | append: '-buscar' -%}
{%- assign tire_finder_instructions_id = tire_finder_id | append: '-instrucciones' -%}
{%- assign tire_finder_status_id = tire_finder_id | append: '-estado' -%}
{%- assign tire_finder_updates_id = tire_finder_id | append: '-actualizaciones' -%}
{%- assign tire_usage_filter = nil -%}
{%- for filter in collection.filters -%}
  {%- assign tire_filter_label = filter.label | downcase -%}
  {%- if tire_filter_label contains 'uso' -%}
    {%- assign tire_usage_filter = filter -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} Settings for assets/tire-finder.js {%- endcomment -%}
<div
  class="pf-wrapper{% if request.page_type == 'collection' %} pf-wrapper--landing{% endif %}"
  id="{{ tire_finder_id }}"
  data-tire-finder
  data-storefront-token="{{ section.settings.storefront_token | escape }}"
  data-collection-handle="{{ collections[section.settings.target_collection].handle | default: 'all' | escape }}"
  data-collection-url="{{ collections[section.settings.target_collection].url | default: '/collections/all' | escape }}"
  data-source="{{ request.page_type | escape }}"
  data-results-count="{{ collection.products_count | default: -1 }}"
  data-require-profile="{{ section.settings.require_metric_profile }}"
  aria-busy="true">
  <div class="pf-inner page-width">
    <div class="pf-accent" aria-hidden="true"></div>
    <div class="pf-header">
      <div>
        <h2 class="pf-title">{{ section.settings.title }}</h2>
        {%- if section.settings.help_text != blank -%}
          <p class="pf-help">{{ section.settings.help_text | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    <p id="{{ tire_finder_instructions_id }}" class="pf-sr-only">
      {%- if section.settings.require_metric_profile -%}
        Selecciona la medida del neumático. El perfil es obligatorio para medidas métricas y puede quedar vacío en medidas americanas.
      {%- else -%}
        Selecciona la medida del neumático. El aro es obligatorio; el ancho y el perfil son opcionales.
      {%- endif -%}
      Las opciones disponibles se actualizan según cada selección.
    </p>

    <div class="pf-card" role="search" aria-label="Buscar neumáticos por medida" aria-describedby="{{ tire_finder_instructions_id }}">
      <!-- Paso 1: Ancho -->
      <div class="pf-step" data-step="1">
        <div class="pf-step-number" aria-hidden="true">1</div>
        <div class="pf-field">
          <label class="pf-label" for="{{ tire_finder_ancho_id }}">Ancho</label>
          <div class="pf-select-wrap">
            <select id="{{ tire_finder_ancho_id }}" class="pf-select" aria-describedby="{{ tire_finder_instructions_id }}" aria-required="false" disabled>
              <option value="">Cargando...</option>
            </select>
            <span class="pf-select-icon" aria-hidden="true">▾</span>
          </div>
        </div>
      </div>

      <!-- Paso 2: Perfil -->
      <div class="pf-step" data-step="2">
        <div class="pf-step-number" aria-hidden="true">2</div>
        <div class="pf-field">
          <label class="pf-label" for="{{ tire_finder_aspecto_id }}">Perfil{% unless section.settings.require_metric_profile %} <span class="pf-optional">(opcional)</span>{% endunless %}</label>
          <div class="pf-select-wrap">
            <select id="{{ tire_finder_aspecto_id }}" class="pf-select" aria-describedby="{{ tire_finder_instructions_id }}" aria-required="false" disabled>
              <option value="">— Cualquier perfil —</option>
            </select>
            <span class="pf-select-icon" aria-hidden="true">▾</span>
          </div>
        </div>
      </div>

      <!-- Paso 3: Aro (diámetro) -->
      <div class="pf-step" data-step="3">
        <div class="pf-step-number" aria-hidden="true">3</div>
        <div class="pf-field">
          <label class="pf-label" for="{{ tire_finder_aro_id }}">Aro</label>
          <div class="pf-select-wrap">
            <select id="{{ tire_finder_aro_id }}" class="pf-select" aria-describedby="{{ tire_finder_instructions_id }}" aria-required="true" disabled>
              <option value="">— Selecciona Aro —</option>
            </select>
            <span class="pf-select-icon" aria-hidden="true">▾</span>
          </div>
        </div>
      </div>

      {%- if tire_usage_filter != nil -%}
        <div class="pf-step" data-step="4">
          <div class="pf-step-number" aria-hidden="true">4</div>
          <div class="pf-field">
            <label class="pf-label" for="{{ tire_finder_use_id }}">Tipo de uso <span class="pf-optional">(opcional)</span></label>
            <div class="pf-select-wrap">
              <select id="{{ tire_finder_use_id }}" class="pf-select" data-param-name="{{ tire_usage_filter.param_name | escape }}">
                <option value="">— Todos los usos —</option>
                {%- for value in tire_usage_filter.values -%}
                  <option value="{{ value.value | escape }}"{% if value.active %} selected{% endif %}>{{ value.label | escape }}</option>
                {%- endfor -%}
              </select>
              <span class="pf-select-icon" aria-hidden="true">▾</span>
            </div>
          </div>
        </div>
      {%- endif -%}

      <!-- Botón de búsqueda -->
      <div class="pf-step pf-step--action">
        <button id="{{ tire_finder_button_id }}" class="pf-btn" type="button" aria-describedby="{{ tire_finder_instructions_id }}" disabled>
          <span class="pf-btn-text">{{ section.settings.button_label | escape }}</span>
          <span class="pf-btn-icon" aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- Estado de carga / error -->
    <div id="{{ tire_finder_status_id }}" class="pf-status" role="status" aria-live="polite" aria-atomic="true" style="display:none;">
      <span class="pf-status-icon" aria-hidden="true"></span>
      <span class="pf-status-message"></span>
      <button class="pf-status-clear" type="button">limpiar filtros</button>
      <a class="pf-status-fallback" hidden>Ver resultados</a>
    </div>
    <div id="{{ tire_finder_updates_id }}" class="pf-sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

  </div>
</div>

<style>
  :root {
    --pf-accent: {{ section.settings.accent_color }};
    --pf-bg: #FFFFFF;
    --pf-card: #FFFFFF;
    --pf-border: #D6D6D6;
    --pf-input-bg: #FFFFFF;
    --pf-text: #1C1C1C;
    --pf-muted: #666666;
    --pf-step-size: 28px;
    --pf-radius: 0;
    --pf-transition: 0.25s ease;
  }

  .pf-wrapper {
    background: var(--pf-bg);
    margin-block: 20px;
    padding: 0 0 54px;
    font-family: 'Arial Narrow', Arial, sans-serif;
    border-top: none;
    border-bottom: none;
  }

  .pf-accent {
    display: none;
  }

  .pf-inner {
    max-width: 1520px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .pf-sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .pf-header {
    text-align: left;
    margin-bottom: 26px;
  }
  .pf-title {
    color: var(--pf-text);
    font-size: clamp(2.4rem, 1.7vw, 3rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.98;
    margin: 0;
    text-transform: uppercase;
  }
  .pf-title::after {
    content: none;
  }
  .pf-help {
    color: var(--pf-muted);
    font-size: 1.4rem;
    line-height: 1.5;
    margin: 10px 0 0;
  }

  .pf-card {
    background: var(--pf-card);
    border: none;
    border-radius: var(--pf-radius);
    padding: 0;
    display: grid;
    grid-template-columns: minmax(240px, 1fr) minmax(240px, 1fr) minmax(240px, 1fr) 250px;
    gap: 8px;
    align-items: end;
  }

  .pf-step {
    position: relative;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    align-items: end;
    gap: 10px;
    min-width: 0;
  }
  .pf-step--action {
    display: block;
    align-items: end;
  }

  .pf-step-number {
    width: var(--pf-step-size);
    height: var(--pf-step-size);
    min-width: var(--pf-step-size);
    background: #e9e9eb;
    color: var(--pf-muted);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 900;
    margin-top: 0;
    margin-bottom: 4px;
    transition: background var(--pf-transition), color var(--pf-transition);
  }

  .pf-step.is-active .pf-step-number {
    background: var(--pf-accent);
    color: #fff;
  }

  .pf-field {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pf-label {
    color: var(--pf-text);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }
  .pf-optional {
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.68rem;
    opacity: 0.7;
  }

  .pf-select-wrap {
    position: relative;
  }
  .pf-select {
    width: 100%;
    height: 40px;
    padding: 0 34px 0 14px;
    background: var(--pf-input-bg);
    border: 1px solid var(--pf-border);
    border-radius: 0;
    color: var(--pf-text);
    font-size: 1.4rem;
    font-weight: 400;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    transition: border-color var(--pf-transition), box-shadow var(--pf-transition);
    outline: none;
  }
  .pf-select:focus {
    border-color: var(--pf-accent);
    box-shadow: 0 0 0 1px var(--pf-accent);
  }
  .pf-select:focus-visible,
  .pf-btn:focus-visible {
    outline: 2px solid var(--pf-accent);
    outline-offset: 2px;
  }
  .pf-select:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .pf-select option {
    background: #FFFFFF;
    color: var(--pf-text);
  }
  .pf-select-icon {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--pf-text);
    pointer-events: none;
    font-size: 0.85rem;
  }

  .pf-btn {
    width: 100%;
    height: 40px;
    padding: 0 20px;
    background: var(--pf-accent);
    color: #fff;
    border: none;
    border-radius: 0;
    font-size: 1.2rem;
    font-weight: 900;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: opacity var(--pf-transition), transform var(--pf-transition);
  }
  .pf-btn:hover:not(:disabled) {
    opacity: 0.88;
    transform: translateY(-1px);
  }
  .pf-btn:active:not(:disabled) {
    transform: translateY(0);
  }
  .pf-btn:disabled {
    background: var(--pf-accent);
    color: #fff;
    cursor: not-allowed;
    transform: none;
    border: 1px solid var(--pf-accent);
    opacity: 1;
  }
  .pf-btn-icon {
    font-size: 1.1rem;
    transition: transform var(--pf-transition);
  }
  .pf-btn:hover:not(:disabled) .pf-btn-icon {
    transform: translateX(4px);
  }

  .pf-status {
    text-align: left;
    margin-top: 16px;
    font-size: 1.3rem;
    color: var(--pf-muted);
  }
  .pf-status.is-error {
    color: #FF6600;
  }

  .pf-status-icon,
  .pf-status-clear {
    display: none;
  }

  .pf-wrapper--landing {
    background: #f4f5f7;
    margin: 0;
    padding: 0;
    position: relative;
    z-index: 3;
  }

  .pf-wrapper--landing .pf-inner {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 22px 55px rgba(18, 18, 18, .16);
    margin-bottom: -5.2rem;
    max-width: min(1380px, calc(100% - 12rem));
    overflow: hidden;
    padding: 0 2.8rem 1.2rem;
    transform: translateY(-5.2rem);
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    .pf-wrapper--landing .pf-inner {
      max-width: calc(100% - 6rem);
    }
  }

  @media (max-width: 767px) {
    .pf-wrapper--landing .pf-inner {
      max-width: calc(100% - 3rem);
    }
  }

  .pf-wrapper--landing .pf-accent {
    background: var(--pf-accent);
    display: block;
    height: 7px;
    margin: 0 -2.8rem 2.6rem;
  }

  .pf-wrapper--landing .pf-header {
    align-items: center;
    display: flex;
    gap: 1.4rem;
    margin-bottom: 2.4rem;
  }

  .pf-wrapper--landing .pf-title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.9rem, 1.6vw, 2.4rem);
  }

  .pf-wrapper--landing .pf-help {
    margin-top: .5rem;
  }

  .pf-wrapper--landing .pf-card {
    grid-template-columns: repeat(4, minmax(150px, 1fr)) minmax(190px, .9fr);
    gap: 1.2rem;
  }

  .pf-wrapper--landing .pf-step {
    display: block;
  }

  .pf-wrapper--landing .pf-step-number {
    display: none;
  }

  .pf-wrapper--landing .pf-label {
    font-family: var(--font-heading-family);
    font-size: 1.15rem;
  }

  .pf-wrapper--landing .pf-select,
  .pf-wrapper--landing .pf-btn {
    border-radius: 7px;
    height: 48px;
  }

  .pf-wrapper--landing .pf-select {
    background: #f2f3f5;
    border-color: transparent;
    font-family: var(--font-body-family);
    font-size: 1.45rem;
    font-weight: 700;
  }

  .pf-wrapper--landing .pf-select:hover:not(:disabled) {
    border-color: #d3d5d8;
  }

  .pf-wrapper--landing .pf-btn {
    box-shadow: 0 8px 18px rgba(255, 102, 0, .2);
    font-family: var(--font-heading-family);
    font-size: 1.45rem;
  }

  .pf-wrapper--landing .pf-btn:disabled {
    opacity: .48;
  }

  .pf-wrapper--landing .pf-status {
    align-items: center;
    background: #eef4ff;
    border: 1px solid #dce7f7;
    border-radius: 8px;
    color: #26384f;
    display: flex;
    font-size: 1.5rem;
    gap: .8rem;
    line-height: 1.45;
    margin-top: 1.2rem;
    min-height: 49px;
    padding: .6rem .8rem;
  }

  .pf-wrapper--landing .pf-status-icon {
    align-items: center;
    background: var(--pf-accent);
    border-radius: 50%;
    color: #fff;
    display: flex;
    flex: 0 0 22px;
    font-size: 1.1rem;
    font-weight: 900;
    height: 22px;
    justify-content: center;
  }

  .pf-wrapper--landing .pf-status-message {
    flex: 1;
    font-weight: 700;
  }

  .pf-wrapper--landing .pf-status-measurement {
    font-weight: 900;
  }

  .pf-wrapper--landing .pf-status-clear {
    background: #fff;
    border: 1px solid #d6d9de;
    border-radius: 5px;
    color: #222;
    cursor: pointer;
    display: none;
    font-family: var(--font-heading-family);
    font-size: 1.3rem;
    font-weight: 800;
    min-height: 30px;
    padding: .5rem .9rem;
    text-transform: none;
  }

  .pf-wrapper--landing .pf-status.has-clear .pf-status-clear { display: inline-flex; }
  .pf-wrapper--landing .pf-status.is-warning { background: #fff5da; border-color: #f1d690; color: #614900; }
  .pf-wrapper--landing .pf-status.is-warning .pf-status-icon { background: #c78000; }
  .pf-wrapper--landing .pf-status.is-error { background: #fff0ed; border-color: #f2c7bf; color: #8f2a1b; }
  .pf-wrapper--landing .pf-status.is-error .pf-status-icon { background: #b73a26; }
  .pf-wrapper--landing .pf-status.is-empty { background: #f1f2f3; border-color: #d9dadd; color: #3c4145; }
  .pf-wrapper--landing .pf-status.is-empty .pf-status-icon { background: #656a6e; }

  /* Inch sizes (ancho < 20) have no profile: the step is hidden and the row closes the gap. */
  .pf-step[hidden] { display: none !important; }
  @media (min-width: 961px) {
    .pf-card.is-no-profile {
      grid-template-columns: repeat(var(--pf-visible-steps, 2), minmax(240px, 1fr)) 250px;
    }
    .pf-wrapper--landing .pf-card.is-no-profile {
      grid-template-columns: repeat(var(--pf-visible-steps, 3), minmax(150px, 1fr)) minmax(190px, .9fr);
    }
  }

  @media (max-width: 960px) {
    .pf-card {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .pf-step--action {
      grid-column: 1 / -1;
    }
    .pf-wrapper--landing .pf-card {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pf-wrapper--landing .pf-step--action {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .pf-wrapper {
      padding: 0 0 34px;
    }
    .pf-title {
      font-size: 2.4rem;
    }
    .pf-card {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .pf-wrapper--landing { padding-bottom: 0; }
    .pf-wrapper--landing .pf-inner {
      border-radius: 9px;
      margin-bottom: -3.8rem;
      max-width: calc(100% - 3rem);
      padding: 0 1.6rem 1.2rem;
      transform: translateY(-3.8rem);
    }
    .pf-wrapper--landing .pf-accent { margin: 0 -1.6rem 2rem; }
    .pf-wrapper--landing .pf-header { align-items: flex-start; }
    .pf-wrapper--landing .pf-card { grid-template-columns: 1fr; }
    .pf-wrapper--landing .pf-status { align-items: flex-start; flex-wrap: wrap; }
    .pf-wrapper--landing .pf-status-clear { margin-left: 4rem; }
    .pf-select,
    .pf-btn {
      height: 42px;
    }
  }
</style>

<script src="{{ 'tire-finder.js' | asset_url }}" defer="defer"></script>
{% if request.page_type == 'collection' and template.suffix == 'neumaticos' %}
  <script src="{{ 'tire-collection-results.js' | asset_url }}" defer="defer"></script>
{% endif %}
