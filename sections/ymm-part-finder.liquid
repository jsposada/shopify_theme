{{ 'seo-parts-landing.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign target_collection = section.settings.target_collection
  assign catalog_url = target_collection.url | default: '/collections/repuestos'
-%}

<section
  id="YmmFinder-{{ section.id }}"
  class="ymm-finder-section"
  data-parts-finder
  data-api-root="{{ section.settings.api_root | default: '/apps/ymm' | escape }}"
  data-catalog-url="{{ catalog_url | escape }}"
  data-whatsapp-number="{{ section.settings.whatsapp_number | remove: ' ' | remove: '+' | escape }}"
>
  <div class="container">
    <div class="ymm-finder">
      <header class="ymm-finder__header">
        <div>
          <h2 class="ymm-finder__title">{{ section.settings.title | escape }}</h2>
          <p class="ymm-finder__help">{{ section.settings.help_text | escape }}</p>
        </div>
      </header>

      <form class="ymm-finder__form" novalidate>
        <div class="ymm-field">
          <label for="YmmMake-{{ section.id }}">Marca</label>
          <select id="YmmMake-{{ section.id }}" data-ymm-make disabled>
            <option value="">Cargando marcas…</option>
          </select>
        </div>

        <div class="ymm-field">
          <label for="YmmModel-{{ section.id }}">Modelo</label>
          <select id="YmmModel-{{ section.id }}" data-ymm-model disabled>
            <option value="">Selecciona una marca</option>
          </select>
        </div>

        <div class="ymm-field">
          <label for="YmmYear-{{ section.id }}">Año <span class="visually-hidden">opcional</span></label>
          <select id="YmmYear-{{ section.id }}" data-ymm-year disabled>
            <option value="">Selecciona un modelo</option>
          </select>
        </div>

        <div class="ymm-field">
          <label for="YmmPartType-{{ section.id }}">Tipo de repuesto <span class="visually-hidden">opcional</span></label>
          <select id="YmmPartType-{{ section.id }}" data-ymm-part-type disabled>
            <option value="">Selecciona un modelo</option>
          </select>
        </div>

        <button class="ymm-finder__submit" type="submit" data-ymm-submit disabled>
          <span data-ymm-submit-label>{{ section.settings.button_label | escape }}</span>
          <span aria-hidden="true">→</span>
        </button>
      </form>

      <div class="ymm-finder__status" role="status" aria-live="polite" data-ymm-status></div>
      <button type="button" class="ymm-finder__retry" data-ymm-retry hidden>Intentar nuevamente</button>

      <div class="ymm-selection" data-ymm-selection hidden>
        <span class="ymm-selection__icon" aria-hidden="true">✓</span>
        <p class="ymm-selection__message">
          tu moto: <strong class="ymm-selection__vehicle" data-ymm-vehicle></strong>.
          <span data-ymm-availability>buscando repuestos disponibles…</span>
        </p>
        <button class="ymm-selection__change" type="button" data-ymm-change>cambiar moto</button>
      </div>
    </div>
  </div>

  <div class="ymm-results" id="YmmResults" data-ymm-results hidden>
    <div class="container">
      <div class="ymm-results__layout">
        <aside class="ymm-results__filters" aria-label="Filtros de resultados compatibles">
          <header class="ymm-results__filters-header">
            <span class="ymm-results__filters-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M4 6h16M7 12h10M10 18h4" />
                <circle cx="8" cy="6" r="1.5" fill="currentColor" stroke="none" />
                <circle cx="15" cy="12" r="1.5" fill="currentColor" stroke="none" />
                <circle cx="12" cy="18" r="1.5" fill="currentColor" stroke="none" />
              </svg>
            </span>
            <h2>Filtros</h2>
            <button type="button" data-ymm-clear-filters>limpiar todo</button>
          </header>
          <div data-ymm-result-filters></div>
        </aside>

        <div class="ymm-results__main">
          <div class="ymm-results__toolbar">
            <header class="ymm-results__header">
              <h2 class="ymm-results__title" tabindex="-1" data-ymm-results-title>Repuestos compatibles</h2>
              <p class="ymm-results__count" aria-live="polite" data-ymm-results-count></p>
            </header>

            <div class="ymm-results__controls">
              <div class="ymm-results__views" aria-label="Vista de resultados">
                <button type="button" class="is-active" aria-label="Vista de cuadrícula" aria-pressed="true" data-ymm-view="grid">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                </button>
                <button type="button" aria-label="Vista de lista" aria-pressed="false" data-ymm-view="list">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg>
                </button>
              </div>
              <label class="ymm-results__sort">
                <span>Ordenar por:</span>
                <select data-ymm-sort>
                  <option value="relevance">Relevancia</option>
                  <option value="price-asc">Precio: menor a mayor</option>
                  <option value="price-desc">Precio: mayor a menor</option>
                  <option value="title">Nombre</option>
                </select>
              </label>
            </div>
          </div>

          <div class="ymm-results__active-filters" data-ymm-active-filters></div>
          <div class="ymm-results__grid" data-ymm-grid></div>

          <div class="ymm-results__footer">
            <button class="ymm-results__more" type="button" data-ymm-more hidden>Cargar más</button>
          </div>

          <div class="ymm-empty" data-ymm-empty hidden>
            <h3 tabindex="-1" data-ymm-empty-title>No encontramos una coincidencia publicada</h3>
            <p data-ymm-empty-message>No encontramos repuestos publicados para esta selección. Puedes escribirnos por WhatsApp y te ayudamos a encontrarlo.</p>
            <div class="ymm-empty__actions">
              <button class="ymm-action ymm-action--secondary" type="button" data-ymm-empty-change>Cambiar selección</button>
              <a class="ymm-action" href="{{ catalog_url }}">Explorar categorías</a>
              <a class="ymm-action ymm-action--whatsapp" href="#" target="_blank" rel="noopener" data-ymm-whatsapp>Consultar por WhatsApp</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('YmmFinder-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const apiRoot = root.dataset.apiRoot.replace(/\/$/, '');
    const catalogUrl = root.dataset.catalogUrl;
    const whatsappNumber = root.dataset.whatsappNumber || '56977670252';
    const form = root.querySelector('.ymm-finder__form');
    const makeSelect = root.querySelector('[data-ymm-make]');
    const modelSelect = root.querySelector('[data-ymm-model]');
    const yearSelect = root.querySelector('[data-ymm-year]');
    const typeSelect = root.querySelector('[data-ymm-part-type]');
    const submitButton = root.querySelector('[data-ymm-submit]');
    const submitLabel = root.querySelector('[data-ymm-submit-label]');
    const status = root.querySelector('[data-ymm-status]');
    const retryButton = root.querySelector('[data-ymm-retry]');
    const selection = root.querySelector('[data-ymm-selection]');
    const vehicle = root.querySelector('[data-ymm-vehicle]');
    const availability = root.querySelector('[data-ymm-availability]');
    const results = root.querySelector('[data-ymm-results]');
    const resultsTitle = root.querySelector('[data-ymm-results-title]');
    const resultsCount = root.querySelector('[data-ymm-results-count]');
    const grid = root.querySelector('[data-ymm-grid]');
    const moreButton = root.querySelector('[data-ymm-more]');
    const empty = root.querySelector('[data-ymm-empty]');
    const emptyTitle = root.querySelector('[data-ymm-empty-title]');
    const emptyMessage = root.querySelector('[data-ymm-empty-message]');
    const whatsapp = root.querySelector('[data-ymm-whatsapp]');
    const resultFilters = root.querySelector('[data-ymm-result-filters]');
    const activeResultFilters = root.querySelector('[data-ymm-active-filters]');
    const clearResultFiltersButton = root.querySelector('[data-ymm-clear-filters]');
    const sortResultsSelect = root.querySelector('[data-ymm-sort]');
    const viewButtons = root.querySelectorAll('[data-ymm-view]');
    const defaultSubmitLabel = submitLabel.textContent;

    let availableTypes = [];
    let nextCursor = null;
    let activePartType = '';
    let requestSequence = 0;
    let currentProducts = [];
    let requestController = null;
    let retryAction = null;
    let makesLoaded = false;
    const selectedResultFilters = {
      brand: new Set(),
      partType: new Set()
    };

    function publish(name, payload = {}) {
      if (window.Shopify && Shopify.analytics && typeof Shopify.analytics.publish === 'function') {
        try {
          const result = Shopify.analytics.publish(`bikerz:${name}`, payload);
          result?.catch?.(() => {});
        } catch (error) { console.debug('[Bikerz YMM] Analytics:', error); }
      }
    }

    function setStatus(message = '', kind = '') {
      status.textContent = message;
      status.dataset.kind = kind;
      retryButton.hidden = true;
      retryAction = null;
    }

    function showRetry(action) {
      retryAction = action;
      retryButton.hidden = false;
    }

    function beginRequest() {
      const sequence = ++requestSequence;
      requestController?.abort();
      requestController = new AbortController();
      return sequence;
    }

    function scrollToResults() {
      const target = empty.hidden ? resultsTitle : emptyTitle;
      target.focus({ preventScroll: true });
      results.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    }

    function saveSearchUrl() {
      const url = new URL(window.location.href);
      for (const key of [...url.searchParams.keys()]) {
        if (key.startsWith('ymm_') || key.startsWith('filter.') || key === 'page' || key === 'sort_by') url.searchParams.delete(key);
      }
      for (const [key, value] of Object.entries({ ymm_make: makeSelect.value, ymm_model: modelSelect.value, ymm_year: yearSelect.value, ymm_type: typeSelect.value })) {
        if (value) url.searchParams.set(key, value);
      }
      if (sortResultsSelect.value !== 'relevance') url.searchParams.set('ymm_sort', sortResultsSelect.value);
      if (grid.classList.contains('is-list')) url.searchParams.set('ymm_view', 'list');
      for (const value of selectedResultFilters.brand) url.searchParams.append('ymm_brand', value);
      for (const value of selectedResultFilters.partType) url.searchParams.append('ymm_result_type', value);
      url.hash = 'YmmResults';
      if (url.href !== window.location.href) history.pushState({ searchParams: url.search.slice(1) }, '', url);
      const Facets = customElements.get('facet-filters-form');
      if (Facets) Facets.searchParamsPrev = url.search.slice(1);
    }

    function setOptions(select, items, placeholder, valueKey = 'id', labelKey = 'name') {
      select.replaceChildren();
      const placeholderOption = document.createElement('option');
      placeholderOption.value = '';
      placeholderOption.textContent = placeholder;
      select.appendChild(placeholderOption);
      items.forEach((item) => {
        const option = document.createElement('option');
        option.value = String(item[valueKey]);
        option.textContent = item[labelKey];
        select.appendChild(option);
      });
      select.disabled = false;
    }

    function resetSelect(select, message) {
      setOptions(select, [], message);
      select.disabled = true;
    }

    function selectedText(select) {
      return select.options[select.selectedIndex]?.textContent?.trim() || '';
    }

    function queryString(parameters) {
      const query = new URLSearchParams();
      Object.entries(parameters).forEach(([key, value]) => {
        if (value !== '' && value !== null && value !== undefined) query.set(key, value);
      });
      return query.toString();
    }

    async function api(path, parameters = {}) {
      const query = queryString(parameters);
      const controller = requestController || new AbortController();
      const timeout = setTimeout(() => controller.abort(), 15000);
      try {
        const response = await fetch(`${apiRoot}${path}${query ? `?${query}` : ''}`, {
          signal: controller.signal,
          credentials: 'same-origin',
          headers: { Accept: 'application/json' }
        });
        let payload;
        try {
          payload = await response.json();
        } catch (_error) {
          throw new Error('El servicio devolvió una respuesta inesperada.');
        }
        if (!response.ok) {
          throw new Error(payload?.error?.message || 'No pudimos consultar las compatibilidades.');
        }
        return payload;
      } finally {
        clearTimeout(timeout);
      }
    }

    function currentVehicleLabel() {
      const year = yearSelect.value ? ` · ${yearSelect.value}` : '';
      return `${selectedText(makeSelect)} ${selectedText(modelSelect)}${year}`.trim();
    }

    function updateWhatsappLink() {
      const year = yearSelect.value || 'año por confirmar';
      const message = `Hola Bikerz, necesito ayuda para confirmar un repuesto compatible con mi moto: ${selectedText(makeSelect)} ${selectedText(modelSelect)} · ${year}.`;
      whatsapp.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
    }

    function showSelection() {
      vehicle.textContent = currentVehicleLabel();
      availability.textContent = 'buscando repuestos disponibles…';
      selection.dataset.kind = 'info';
      selection.hidden = false;
      updateWhatsappLink();
    }

    function updateSelectionCount(total) {
      availability.textContent = `mostrando ${total} ${total === 1 ? 'resultado' : 'resultados'}.`;
      selection.dataset.kind = total ? 'info' : 'empty';
    }

    function setBusy(isBusy) {
      root.setAttribute('aria-busy', String(isBusy));
      results.setAttribute('aria-busy', String(isBusy));
      submitButton.disabled = isBusy || !modelSelect.value;
      submitLabel.textContent = isBusy ? 'Buscando…' : defaultSubmitLabel;
      makeSelect.disabled = isBusy;
      modelSelect.disabled = isBusy;
      yearSelect.disabled = isBusy || !modelSelect.value;
      typeSelect.disabled = isBusy || !modelSelect.value;
      moreButton.disabled = isBusy;
      results.querySelectorAll('input, select, button').forEach(control => { control.disabled = isBusy; });
      if (!isBusy) clearResultFiltersButton.disabled = !selectedResultFilters.brand.size && !selectedResultFilters.partType.size;
    }

    function formatMoney(price) {
      const amount = Number(price?.amount);
      const currency = price?.currency || 'CLP';
      if (!Number.isFinite(amount)) return 'Precio no disponible';
      return new Intl.NumberFormat('es-CL', {
        style: 'currency',
        currency,
        maximumFractionDigits: currency === 'CLP' ? 0 : 2
      }).format(amount);
    }

    function productCard(product, index) {
      const article = document.createElement('article');
      article.className = 'ymm-product-card';
      article.dataset.brand = product.brand || 'Sin marca';
      article.dataset.partType = product.part_type_label || 'Otros repuestos';
      article.dataset.price = String(Number(product.price?.amount) || 0);
      article.dataset.title = product.title || 'Repuesto para moto';
      article.dataset.resultIndex = String(index);

      if (product.match_level === 'exact_year') {
        const badge = document.createElement('span');
        badge.className = 'ymm-product-card__compatibility';
        badge.textContent = 'Compatible con tu moto';
        article.appendChild(badge);
      }

      const imageLink = document.createElement('a');
      imageLink.className = 'ymm-product-card__image';
      imageLink.href = product.url;
      imageLink.dataset.ymmProductLink = '';
      if (product.image?.url) {
        const image = document.createElement('img');
        image.src = product.image.url;
        image.alt = product.image.alt || product.title || '';
        image.loading = 'lazy';
        image.width = 500;
        image.height = 500;
        imageLink.appendChild(image);
      } else {
        imageLink.classList.add('ymm-product-card__image--empty');
        imageLink.textContent = 'Imagen no disponible';
      }
      article.appendChild(imageLink);

      const body = document.createElement('div');
      body.className = 'ymm-product-card__body';

      if (product.brand) {
        const brand = document.createElement('p');
        brand.className = 'ymm-product-card__brand';
        brand.textContent = product.brand;
        body.appendChild(brand);
      }

      const title = document.createElement('a');
      title.className = 'ymm-product-card__title';
      title.href = product.url;
      title.textContent = product.title || 'Repuesto para moto';
      title.dataset.ymmProductLink = '';
      body.appendChild(title);

      const type = document.createElement('p');
      type.className = 'ymm-product-card__type';
      type.textContent = product.part_type_label || '';
      body.appendChild(type);

      const price = document.createElement('p');
      price.className = 'ymm-product-card__price';
      price.textContent = formatMoney(product.price);
      body.appendChild(price);

      const stock = document.createElement('p');
      stock.className = `ymm-product-card__stock${product.available ? '' : ' ymm-product-card__stock--out'}`;
      stock.textContent = product.available ? 'Disponible' : 'Sin stock disponible';
      body.appendChild(stock);

      article.appendChild(body);
      return article;
    }

    function renderProducts(items, append = false) {
      if (!append) grid.replaceChildren();
      const fragment = document.createDocumentFragment();
      const startIndex = append ? grid.children.length : 0;
      items.forEach((product, index) => fragment.appendChild(productCard(product, startIndex + index)));
      grid.appendChild(fragment);
      grid.querySelectorAll('[data-ymm-product-link]').forEach((link) => {
        if (link.dataset.analyticsBound === 'true') return;
        link.dataset.analyticsBound = 'true';
        link.addEventListener('click', () => publish('ymm_product_click', {
          has_year: Boolean(yearSelect.value),
          part_type_selected: Boolean(typeSelect.value)
        }));
      });
    }

    function countResultValues(key) {
      const counts = new Map();
      currentProducts.forEach((product) => {
        const value = key === 'brand'
          ? (product.brand || 'Sin marca')
          : (product.part_type_label || 'Otros repuestos');
        counts.set(value, (counts.get(value) || 0) + 1);
      });
      return [...counts.entries()].sort(([left], [right]) => left.localeCompare(right, 'es'));
    }

    function renderResultFacet(title, key) {
      const values = countResultValues(key);
      if (!values.length) return null;

      const section = document.createElement('section');
      section.className = 'ymm-result-facet';
      const heading = document.createElement('h3');
      heading.textContent = title;
      section.appendChild(heading);

      const list = document.createElement('div');
      list.className = 'ymm-result-facet__list';
      values.forEach(([value, count]) => {
        const label = document.createElement('label');
        label.className = 'ymm-result-facet__option';
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.checked = selectedResultFilters[key].has(value);
        checkbox.addEventListener('change', () => {
          if (checkbox.checked) selectedResultFilters[key].add(value);
          else selectedResultFilters[key].delete(value);
          applyResultFilters();
          saveSearchUrl();
        });
        const text = document.createElement('span');
        text.textContent = value;
        const countElement = document.createElement('small');
        countElement.textContent = `(${count})`;
        label.append(checkbox, text, countElement);
        list.appendChild(label);
      });
      section.appendChild(list);
      return section;
    }

    function renderResultFacets() {
      resultFilters.replaceChildren();
      const brandFacet = renderResultFacet('Marca', 'brand');
      const typeFacet = renderResultFacet('Tipo de repuesto', 'partType');
      if (brandFacet) resultFilters.appendChild(brandFacet);
      if (typeFacet) resultFilters.appendChild(typeFacet);
    }

    function renderActiveResultFilters() {
      activeResultFilters.replaceChildren();
      Object.entries(selectedResultFilters).forEach(([key, values]) => {
        values.forEach((value) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'ymm-results__filter-chip';
          button.setAttribute('aria-label', `Quitar filtro ${value}`);
          button.textContent = `× ${value}`;
          button.addEventListener('click', () => {
            selectedResultFilters[key].delete(value);
            renderResultFacets();
            applyResultFilters();
            saveSearchUrl();
          });
          activeResultFilters.appendChild(button);
        });
      });
      if (activeResultFilters.children.length) {
        const clear = document.createElement('button');
        clear.type = 'button';
        clear.className = 'ymm-results__clear-active';
        clear.textContent = 'limpiar todo';
        clear.addEventListener('click', clearResultFilters);
        activeResultFilters.appendChild(clear);
      }
    }

    function updateResultsSummary(total) {
      const vehicleElement = document.createElement('strong');
      vehicleElement.textContent = currentVehicleLabel();
      resultsCount.replaceChildren(
        'Resultados para ',
        vehicleElement,
        ` (${total} ${total === 1 ? 'opción encontrada' : 'opciones encontradas'})`
      );
    }

    function applyResultFilters() {
      let visibleCount = 0;
      [...grid.children].forEach((card) => {
        const brandMatch = !selectedResultFilters.brand.size || selectedResultFilters.brand.has(card.dataset.brand);
        const typeMatch = !selectedResultFilters.partType.size || selectedResultFilters.partType.has(card.dataset.partType);
        card.hidden = !(brandMatch && typeMatch);
        if (!card.hidden) visibleCount += 1;
      });
      updateResultsSummary(visibleCount);
      updateSelectionCount(visibleCount);
      clearResultFiltersButton.disabled = !selectedResultFilters.brand.size && !selectedResultFilters.partType.size;
      renderActiveResultFilters();
    }

    function clearResultFilters() {
      selectedResultFilters.brand.clear();
      selectedResultFilters.partType.clear();
      renderResultFacets();
      applyResultFilters();
      saveSearchUrl();
    }

    function sortResultCards() {
      const mode = sortResultsSelect.value;
      const cards = [...grid.children];
      cards.sort((left, right) => {
        if (mode === 'price-asc') return Number(left.dataset.price) - Number(right.dataset.price);
        if (mode === 'price-desc') return Number(right.dataset.price) - Number(left.dataset.price);
        if (mode === 'title') return left.dataset.title.localeCompare(right.dataset.title, 'es');
        return Number(left.dataset.resultIndex) - Number(right.dataset.resultIndex);
      });
      grid.append(...cards);
    }

    function hideResultLayout() {
      results.hidden = true;
      document.documentElement.classList.remove('ymm-search-has-results');
    }

    function showEmptyState(isError = false, scroll = true) {
      results.hidden = false;
      document.documentElement.classList.remove('ymm-search-has-results');
      currentProducts = [];
      grid.replaceChildren();
      resultFilters.replaceChildren();
      activeResultFilters.replaceChildren();
      moreButton.hidden = true;
      empty.hidden = false;
      availability.textContent = isError
        ? 'no pudimos cargar los repuestos disponibles.'
        : 'no encontramos repuestos disponibles.';
      selection.dataset.kind = isError ? 'error' : 'empty';
      emptyTitle.textContent = isError
        ? 'No pudimos consultar las compatibilidades'
        : 'No encontramos una coincidencia publicada';
      emptyMessage.textContent = isError
        ? 'Puedes navegar por los repuestos manualmente o pedirnos ayuda por WhatsApp.'
        : 'No encontramos repuestos publicados para esta selección. Puedes escribirnos por WhatsApp y te ayudamos a encontrarlo.';
      updateResultsSummary(0);
      if (scroll) scrollToResults();
    }

    function showResults(items, meta, append = false, scroll = true) {
      results.hidden = false;
      empty.hidden = true;
      currentProducts = append ? [...currentProducts, ...items] : [...items];
      renderProducts(items, append);
      renderResultFacets();
      sortResultCards();
      applyResultFilters();
      document.documentElement.classList.add('ymm-search-has-results');
      nextCursor = meta?.page_info?.next_cursor || null;
      moreButton.hidden = !activePartType || !meta?.page_info?.has_next_page;
      if (!append && scroll) {
        scrollToResults();
      }
    }

    async function loadPartTypes(modelId, year = '') {
      const sequence = requestSequence;
      const payload = await api('/part-types', { model_id: modelId, year });
      if (sequence !== requestSequence) return;
      availableTypes = payload.data || [];
      const previous = typeSelect.value;
      setOptions(typeSelect, availableTypes, 'Todos los tipos', 'value', 'label');
      if (availableTypes.some((item) => item.value === previous)) typeSelect.value = previous;
      return availableTypes;
    }

    async function searchSpecificType(partType, cursor = null) {
      return api('/products', {
        model_id: modelSelect.value,
        year: yearSelect.value,
        part_type: partType,
        cursor,
        limit: 12
      });
    }

    async function searchAllTypes() {
      const perType = Math.max(2, Math.ceil(24 / Math.max(availableTypes.length, 1)));
      const responses = await Promise.all(
        availableTypes.map((item) => api('/products', {
          model_id: modelSelect.value,
          year: yearSelect.value,
          part_type: item.value,
          limit: Math.min(perType, 12)
        }))
      );
      const items = responses.flatMap((response) => response.data || []).slice(0, 24);
      return {
        data: items,
        meta: { count: items.length, match_level: yearSelect.value ? 'exact_year' : 'model_only' }
      };
    }

    async function submitSearch(updateHistory = true, scroll = true) {
      if (!modelSelect.value) {
        setStatus('Selecciona una marca y un modelo para buscar.', 'error');
        modelSelect.focus();
        return;
      }

      const sequence = beginRequest();
      root.dispatchEvent(new CustomEvent('bikerz:ymm-search-start'));
      setBusy(true);
      setStatus('Buscando repuestos compatibles…');
      showSelection();
      activePartType = typeSelect.value;
      nextCursor = null;
      currentProducts = [];
      selectedResultFilters.brand.clear();
      selectedResultFilters.partType.clear();
      sortResultsSelect.value = 'relevance';
      grid.classList.remove('is-list');
      viewButtons.forEach((button) => {
        const isGrid = button.dataset.ymmView === 'grid';
        button.classList.toggle('is-active', isGrid);
        button.setAttribute('aria-pressed', String(isGrid));
      });
      publish('ymm_search_submit', {
        has_year: Boolean(yearSelect.value),
        part_type_selected: Boolean(activePartType)
      });

      try {
        const response = activePartType
          ? await searchSpecificType(activePartType)
          : await searchAllTypes();
        if (sequence !== requestSequence) return;
        const items = response.data || [];
        setStatus('');
        if (!items.length) {
          showEmptyState(false, scroll);
          if (updateHistory) saveSearchUrl();
          publish('ymm_no_results', {
            has_year: Boolean(yearSelect.value),
            part_type_selected: Boolean(activePartType)
          });
          return true;
        }
        showResults(items, response.meta || {}, false, scroll);
        if (updateHistory) saveSearchUrl();
        publish('ymm_results_view', {
          result_count: items.length,
          has_year: Boolean(yearSelect.value),
          part_type_selected: Boolean(activePartType)
        });
        return true;
      } catch (error) {
        if (sequence !== requestSequence) return false;
        console.error('[Bikerz YMM]', error);
        setStatus('No pudimos consultar las compatibilidades en este momento.', 'error');
        showEmptyState(true, scroll);
        showRetry(() => submitSearch(updateHistory, scroll));
        return false;
      } finally {
        if (sequence === requestSequence) setBusy(false);
      }
    }

    makeSelect.addEventListener('change', async () => {
      const sequence = beginRequest();
      selection.hidden = true;
      hideResultLayout();
      resetSelect(modelSelect, 'Selecciona una marca');
      resetSelect(yearSelect, 'Selecciona un modelo');
      resetSelect(typeSelect, 'Selecciona un modelo');
      submitButton.disabled = true;
      if (!makeSelect.value) return;
      setStatus('Cargando modelos…');
      publish('ymm_make_selected');
      try {
        const payload = await api('/models', { make_id: makeSelect.value });
        if (sequence !== requestSequence) return;
        setOptions(modelSelect, payload.data || [], 'Selecciona un modelo');
        setStatus('');
      } catch (error) {
        if (sequence !== requestSequence) return;
        console.error('[Bikerz YMM]', error);
        setStatus('No pudimos cargar los modelos. Intenta nuevamente.', 'error');
        showRetry(() => makeSelect.dispatchEvent(new Event('change')));
      }
    });

    modelSelect.addEventListener('change', async () => {
      const sequence = beginRequest();
      selection.hidden = true;
      hideResultLayout();
      resetSelect(yearSelect, 'Selecciona un modelo');
      resetSelect(typeSelect, 'Selecciona un modelo');
      submitButton.disabled = true;
      if (!modelSelect.value) return;
      setStatus('Cargando años y tipos de repuesto…');
      publish('ymm_model_selected');
      try {
        const [years] = await Promise.all([
          api('/years', { model_id: modelSelect.value }),
          loadPartTypes(modelSelect.value)
        ]);
        if (sequence !== requestSequence) return;
        setOptions(
          yearSelect,
          (years.data || []).map((year) => ({ value: year, label: String(year) })),
          'No conozco el año',
          'value',
          'label'
        );
        submitButton.disabled = availableTypes.length === 0;
        setStatus(availableTypes.length ? '' : 'No hay tipos de repuesto publicados para este modelo.', availableTypes.length ? '' : 'error');
      } catch (error) {
        if (sequence !== requestSequence) return;
        console.error('[Bikerz YMM]', error);
        setStatus('No pudimos cargar la información de este modelo. Intenta nuevamente.', 'error');
        showRetry(() => modelSelect.dispatchEvent(new Event('change')));
      }
    });

    yearSelect.addEventListener('change', async () => {
      const sequence = beginRequest();
      selection.hidden = true;
      hideResultLayout();
      submitButton.disabled = true;
      setStatus('Actualizando tipos de repuesto…');
      publish(yearSelect.value ? 'ymm_year_selected' : 'ymm_unknown_year_selected');
      try {
        await loadPartTypes(modelSelect.value, yearSelect.value);
        if (sequence !== requestSequence) return;
        submitButton.disabled = availableTypes.length === 0;
        setStatus(availableTypes.length ? '' : 'No hay tipos de repuesto publicados para esta selección.', availableTypes.length ? '' : 'error');
      } catch (error) {
        if (sequence !== requestSequence) return;
        console.error('[Bikerz YMM]', error);
        setStatus('No pudimos actualizar los tipos de repuesto.', 'error');
        showRetry(() => yearSelect.dispatchEvent(new Event('change')));
      }
    });

    typeSelect.addEventListener('change', () => {
      beginRequest();
      selection.hidden = true;
      hideResultLayout();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      submitSearch();
    });

    clearResultFiltersButton.addEventListener('click', clearResultFilters);
    sortResultsSelect.addEventListener('change', () => {
      sortResultCards();
      saveSearchUrl();
    });
    viewButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const isList = button.dataset.ymmView === 'list';
        grid.classList.toggle('is-list', isList);
        viewButtons.forEach((viewButton) => {
          const isActive = viewButton === button;
          viewButton.classList.toggle('is-active', isActive);
          viewButton.setAttribute('aria-pressed', String(isActive));
        });
        saveSearchUrl();
      });
    });

    moreButton.addEventListener('click', async () => {
      if (!activePartType || !nextCursor) return;
      const sequence = beginRequest();
      setBusy(true);
      setStatus('Cargando más repuestos…');
      try {
        const response = await searchSpecificType(activePartType, nextCursor);
        if (sequence !== requestSequence) return;
        showResults(response.data || [], response.meta || {}, true);
        setStatus('');
      } catch (error) {
        if (sequence !== requestSequence) return;
        console.error('[Bikerz YMM]', error);
        setStatus('No pudimos cargar más repuestos. Intenta nuevamente.', 'error');
        showRetry(() => moreButton.click());
      } finally {
        if (sequence === requestSequence) setBusy(false);
      }
    });

    root.querySelector('[data-ymm-change]').addEventListener('click', () => {
      root.querySelector('.ymm-finder').scrollIntoView({ behavior: 'smooth', block: 'center' });
      makeSelect.focus({ preventScroll: true });
    });

    root.querySelector('[data-ymm-empty-change]').addEventListener('click', () => {
      hideResultLayout();
      root.querySelector('.ymm-finder').scrollIntoView({ behavior: 'smooth', block: 'center' });
      makeSelect.focus({ preventScroll: true });
    });

    whatsapp.addEventListener('click', () => publish('compatibility_help_click', {
      has_year: Boolean(yearSelect.value)
    }));

    retryButton.addEventListener('click', () => retryAction?.());

    async function restoreSearchFromUrl() {
      const url = window.location.href;
      const params = new URL(url).searchParams;
      if (!makesLoaded && params.has('ymm_model')) return initialize();
      const sequence = beginRequest();
      selection.hidden = true;
      hideResultLayout();
      makeSelect.value = '';
      resetSelect(modelSelect, 'Selecciona una marca');
      resetSelect(yearSelect, 'Selecciona un modelo');
      resetSelect(typeSelect, 'Selecciona un modelo');
      setBusy(false);
      modelSelect.disabled = true;
      setStatus('');
      if (!params.get('ymm_make') || !params.get('ymm_model')) return;
      makeSelect.value = params.get('ymm_make');
      if (!makeSelect.value) return;
      root.dispatchEvent(new CustomEvent('bikerz:ymm-search-start'));
      setBusy(true);
      setStatus('Restaurando tu búsqueda…');
      try {
        const models = await api('/models', { make_id: makeSelect.value });
        if (sequence !== requestSequence) return;
        setOptions(modelSelect, models.data || [], 'Selecciona un modelo');
        modelSelect.value = params.get('ymm_model');
        if (!modelSelect.value) throw new Error('El modelo ya no está disponible.');
        const years = await api('/years', { model_id: modelSelect.value });
        if (sequence !== requestSequence) return;
        setOptions(yearSelect, (years.data || []).map(year => ({ value: year, label: String(year) })), 'No conozco el año', 'value', 'label');
        yearSelect.value = params.get('ymm_year') || '';
        await loadPartTypes(modelSelect.value, yearSelect.value);
        if (sequence !== requestSequence) return;
        typeSelect.value = params.get('ymm_type') || '';
        const restored = await submitSearch(false, false);
        if (!restored || requestSequence !== sequence + 1 || window.location.href !== url) return;
        selectedResultFilters.brand = new Set(params.getAll('ymm_brand'));
        selectedResultFilters.partType = new Set(params.getAll('ymm_result_type'));
        const sort = params.get('ymm_sort') || 'relevance';
        sortResultsSelect.value = [...sortResultsSelect.options].some(option => option.value === sort) ? sort : 'relevance';
        const isList = params.get('ymm_view') === 'list';
        grid.classList.toggle('is-list', isList);
        viewButtons.forEach(button => {
          const active = button.dataset.ymmView === (isList ? 'list' : 'grid');
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', String(active));
        });
        renderResultFacets();
        sortResultCards();
        applyResultFilters();
      } catch (error) {
        if (sequence !== requestSequence) return;
        setBusy(false);
        setStatus('No pudimos restaurar la búsqueda. Intenta nuevamente o explora el catálogo.', 'error');
        showRetry(restoreSearchFromUrl);
      }
    }

    window.addEventListener('popstate', () => {
      if (new URLSearchParams(window.location.search).has('ymm_model') || modelSelect.value || !results.hidden || !selection.hidden) {
        restoreSearchFromUrl();
      }
    });

    // Explore the native catalog without leaving the landing or keeping motorcycle results open.
    empty.querySelector('a.ymm-action:not(.ymm-action--whatsapp)').addEventListener('click', event => {
      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const request = new CustomEvent('bikerz:parts-results-search', { cancelable: true, detail: { url: catalogUrl } });
      if (root.dispatchEvent(request)) return;
      event.preventDefault();
      beginRequest();
      hideResultLayout();
      selection.hidden = true;
      setBusy(false);
      setStatus('');
    });

    async function initialize() {
      const sequence = beginRequest();
      setStatus('Cargando marcas…');
      try {
        const payload = await api('/makes');
        if (sequence !== requestSequence) return;
        setOptions(makeSelect, payload.data || [], 'Selecciona una marca');
        makesLoaded = true;
        setStatus('');
        await restoreSearchFromUrl();
      } catch (error) {
        if (sequence !== requestSequence) return;
        console.error('[Bikerz YMM]', error);
        resetSelect(makeSelect, 'No pudimos cargar las marcas');
        setStatus('No pudimos consultar las compatibilidades en este momento. El catálogo sigue disponible más abajo.', 'error');
        showRetry(initialize);
      }
    }

    initialize();
  })();
</script>
{% if request.page_type == 'collection' and template.suffix == 'repuestos' %}
  <script src="{{ 'tire-collection-results.js' | asset_url }}" defer="defer"></script>
{% endif %}

