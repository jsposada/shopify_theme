{{ 'seo-tire-landing.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = section.settings.image
  assign hero_heading = section.settings.heading | default: collection.title
-%}

<section
  class="tire-landing-hero{% if hero_image != blank %} tire-landing-hero--with-image{% endif %}"
  aria-labelledby="TireLandingHero-{{ section.id }}"
  {% if hero_image != blank %}
    style="--tire-hero-image: url('{{ hero_image | image_url: width: 2400 }}'); --tire-hero-position: {{ hero_image.presentation.focal_point | default: 'center' }};"
  {% endif %}
>
  <div class="container tire-landing-hero__inner">
    <div class="tire-landing-hero__content">
      <p class="tire-landing-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="TireLandingHero-{{ section.id }}" class="tire-landing-hero__title">{{ hero_heading | escape }}</h1>
      <div class="tire-landing-hero__intro rte">{{ section.settings.intro }}</div>

      <ul class="tire-landing-hero__proofs" role="list">
        {%- for block in section.blocks -%}
          <li class="tire-landing-hero__proof" {{ block.shopify_attributes }}>
            <span>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

<script>
  document.documentElement.classList.add('seo-tire-landing');
</script>

{% schema %}
{
  "name": "Hero neumáticos SEO",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "Neumáticos Bikerz"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Neumáticos para motos en Chile"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introducción",
      "default": "<p>Encuentra la medida correcta, compara marcas y compra con despacho a todo Chile o instalación en nuestro taller de Santiago.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo",
      "info": "Opcional. Mientras no se seleccione una imagen, se muestra un fondo gráfico oscuro."
    }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Beneficio",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Amplia variedad de medidas y marcas"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero neumáticos SEO",
      "blocks": [
        { "type": "proof" },
        { "type": "proof" },
        { "type": "proof" }
      ]
    }
  ]
}
{% endschema %}
