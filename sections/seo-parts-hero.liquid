{{ 'seo-parts-landing.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = section.settings.image
  assign hero_heading = section.settings.heading | default: collection.title
-%}

<section
  class="parts-landing-hero{% if hero_image != blank %} parts-landing-hero--with-image{% endif %}"
  aria-labelledby="PartsLandingHero-{{ section.id }}"
  {% if hero_image != blank %}
    style="--parts-hero-image: url('{{ hero_image | image_url: width: 2400 }}'); --parts-hero-position: {{ hero_image.presentation.focal_point | default: 'center' }};"
  {% endif %}
>
  <div class="container parts-landing-hero__inner">
    <div class="parts-landing-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="parts-landing-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="PartsLandingHero-{{ section.id }}" class="parts-landing-hero__title">{{ hero_heading | escape }}</h1>
      <div class="parts-landing-hero__intro rte">{{ section.settings.intro }}</div>

      <ul class="parts-landing-hero__proofs" role="list">
        {%- for block in section.blocks -%}
          <li class="parts-landing-hero__proof" {{ block.shopify_attributes }}>
            <span class="parts-landing-hero__check" aria-hidden="true">✓</span>
            <span>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

<script>
  document.documentElement.classList.add('seo-parts-landing');
</script>

{% schema %}
{
  "name": "Hero repuestos SEO",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "Repuestos Bikerz"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Repuestos para motos en Chile"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introducción",
      "default": "<p>Busca por marca, modelo y año para encontrar el repuesto compatible con tu moto.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo",
      "info": "Opcional. Mientras no se seleccione una imagen, se muestra un fondo gráfico oscuro."
    }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Beneficio",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Compatibilidad verificada"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero repuestos SEO",
      "blocks": [
        { "type": "proof" },
        { "type": "proof" },
        { "type": "proof" }
      ]
    }
  ]
}
{% endschema %}
