{%- liquid
  assign help_label = 'Escríbenos por WhatsApp'
  assign help_message = 'Hola, necesito ayuda con una compra en Bikerz.'
  if context == 'product' and product != blank
    assign help_label = 'Consultar compatibilidad por WhatsApp'
    assign help_message = 'Hola, quiero consultar la compatibilidad de ' | append: product.title | append: '. ' | append: shop.url | append: product.url
  elsif context == 'cart'
    assign help_label = '¿Necesitas ayuda con tu pedido?'
  endif
  assign help_message_encoded = help_message | url_encode
-%}
<div class="bikerz-help bikerz-help--{{ context | escape }}">
  <a
    class="bikerz-help__link"
    href="https://wa.me/56977670252?text={{ help_message_encoded }}"
    target="_blank"
    rel="noopener noreferrer"
    data-whatsapp-source="{{ context | escape }}-help"
  >
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a9 9 0 0 1-13.4 7.9L3 21l1.6-4.6A9 9 0 1 1 21 11.5Z"/>
      <path d="M8.2 7.5c.3-.3.6-.2.8.2l1 1.8c.2.3 0 .6-.5 1 .6 1.2 1.5 2.1 2.7 2.7.4-.5.7-.7 1-.5l1.8 1c.4.2.5.5.2.8-.6.9-1.3 1.2-2.4.8-3.1-1-5.3-3.2-6.3-6.3-.4-1.1-.1-1.8.7-2.4Z"/>
    </svg>
    <span>{{ help_label }}</span>
  </a>
</div>
