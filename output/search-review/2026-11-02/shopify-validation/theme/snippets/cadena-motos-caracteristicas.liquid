<details class="tp-faq__item brd-1 mb-20" open="">
  <summary class="tp-collap-tab__sm">
    <h6 class="summary-heading tp-bg flex items-center justify-between mb-0 px-16 py-16">
      <span>Características</span>
      <span class="icon-toggle relative"></span>
    </h6>
  </summary>
  <div class="tp-faq__item-content content-animation px-24 py-16">
    <div class="tab-panel">
      {% assign motos_compatibles = product.metafields.custom.motos_compatibles.value %}
      {% assign moto_fallback = product.metafields.custom.moto.value | default: product.metafields.custom.moto %}

      {% if product.metafields.custom.paso_cadena != blank %}
        <p><strong>Paso cadena:</strong> {{ product.metafields.custom.paso_cadena.value | default: product.metafields.custom.paso_cadena }}</p>
      {% endif %}
      {% if product.metafields.custom.cantidad_eslabones != blank %}
        <p><strong>Cantidad de eslabones:</strong> {{ product.metafields.custom.cantidad_eslabones.value | default: product.metafields.custom.cantidad_eslabones }}</p>
      {% endif %}
      {% if product.metafields.custom.tipo_reten != blank %}
        <p><strong>Tipo de retén:</strong> {{ product.metafields.custom.tipo_reten.value | default: product.metafields.custom.tipo_reten }}</p>
      {% endif %}
      {% if product.metafields.custom.tipo_cierre != blank %}
        <p><strong>Tipo de cierre:</strong> {{ product.metafields.custom.tipo_cierre.value | default: product.metafields.custom.tipo_cierre }}</p>
      {% endif %}
      {% if product.metafields.custom.cilindrada_maxima_soportada != blank %}
        <p><strong>Cilindrada máxima soportada:</strong> {{ product.metafields.custom.cilindrada_maxima_soportada.value | default: product.metafields.custom.cilindrada_maxima_soportada }}</p>
      {% endif %}
      {% if product.metafields.custom.resistencia_traccion != blank %}
        <p><strong>Resistencia a la tracción:</strong> {{ product.metafields.custom.resistencia_traccion.value | default: product.metafields.custom.resistencia_traccion }}</p>
      {% endif %}
      {% if product.metafields.custom.origen != blank %}
        <p><strong>Origen:</strong> {{ product.metafields.custom.origen.value | default: product.metafields.custom.origen }}</p>
      {% endif %}

      {% if motos_compatibles != blank %}
        <p>
          <strong>Motos compatibles:</strong>
          <select class="field__input" aria-label="Motos compatibles">
            <option value="" selected>Ver motos compatibles</option>
            {% for moto in motos_compatibles %}
              {% liquid
                assign moto_nombre = moto.nombre.value | default: moto.nombre
                assign moto_titulo = moto.titulo.value | default: moto.titulo
                assign moto_name = moto.name.value | default: moto.name
                assign moto_marca = moto.marca.value | default: moto.marca
                assign moto_modelo = moto.modelo.value | default: moto.modelo
                assign moto_anio = moto.anio.value | default: moto.anio | default: moto.ano.value | default: moto.ano | default: moto.year.value | default: moto.year
                assign moto_handle = moto.system.handle | replace: '-', ' '
              %}
              {% capture moto_label %}
                {% if moto_nombre != blank %}
                  {{ moto_nombre }}
                {% elsif moto_titulo != blank %}
                  {{ moto_titulo }}
                {% elsif moto_name != blank %}
                  {{ moto_name }}
                {% elsif moto_marca != blank or moto_modelo != blank %}
                  {{ moto_marca }} {{ moto_modelo }} {{ moto_anio }}
                {% elsif moto_handle != blank %}
                  {{ moto_handle }}
                {% else %}
                  {{ moto }}
                {% endif %}
              {% endcapture %}
              {% assign moto_label = moto_label | strip %}
              {% unless moto_label == blank or moto_label == 'MetaobjectDrop' %}
                <option value="{{ moto_label | escape }}">{{ moto_label }}</option>
              {% endunless %}
            {% endfor %}
          </select>
        </p>
      {% elsif moto_fallback != blank %}
        <p>
          <strong>Motos compatibles:</strong>
          <select class="field__input" aria-label="Motos compatibles">
            <option value="" selected>Ver motos compatibles</option>
            <option value="{{ moto_fallback | escape }}">{{ moto_fallback }}</option>
          </select>
        </p>
      {% endif %}
    </div>
  </div>
</details>
