{%- capture active_filters -%}[
  {%- assign pair_count = 0 -%}
  {%- for filter in search.filters -%}
    {%- for value in filter.active_values -%}
      {% if pair_count > 0 %},{% endif %}{"name":{{ filter.param_name | json }},"value":{{ value.value | json }}}
      {%- assign pair_count = pair_count | plus: 1 -%}
    {%- endfor -%}
  {%- endfor -%}
]{%- endcapture -%}
{%- paginate search.results by 5 -%}
{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{% liquid
  assign gst = settings
  assign numberItemSearch = 3
  if gst.header_layout == 'h_layout1'
    assign numberItemSearch = 5
  endif
%}

{%- if search.performed -%}
  {%- capture search_display -%}
    {%- render 'search-display-term', terms: search.terms -%}
  {%- endcapture -%}
  {%- assign tire_collection_url = collections['neumaticos'].url | default: '/collections/neumaticos' -%}
  <div id="predictive-search-results" role="listbox"
    class="search-preview-v2"
    data-search-preview-metadata
    data-query="{{ search.terms | escape }}"
    data-search-filters="{{ active_filters | strip_newlines | escape }}"
    data-products-returned="{{ search.results.size }}"
    data-search-total="{{ search.results_count }}"
  >
  {%- if search.results.size > 0 -%}
    {%- comment -%}
      Primary action, placed first so it stays visible under the input while the
      mobile keyboard is open. type="submit" always searches the current input value.
      Only the inner span carries the data attribute: global.js rewrites its innerText.
      The data-label-* values feed assets/search-normalize.js (rewrite note, tire finder link).
    {%- endcomment -%}
    <button
      type="submit"
      id="predictive-search-option-view-all"
      class="predictive-search__view-all"
      role="option"
      aria-selected="false"
      tabindex="-1"
      data-label-normalized="{{ 'templates.search.showing_results_for' | t | escape }}"
      data-label-tire="{{ 'templates.search.tire_finder_for' | t: size: '__SIZE__' | escape }}"
      data-tire-base="{{ tire_collection_url }}">
      {%- render 'icon', icon_name: 'search', class: 'predictive-search__view-all-icon' -%}
      <span class="predictive-search__view-all-text" data-predictive-search-search-for-text>
        {{- 'templates.search.view_all_for' | t: terms: search_display -}}
      </span>
      {%- render 'icon', icon_name: 'arrow-right' -%}
    </button>
    {%- comment -%}
      Query suggestions Shopify already returns ("casco integral"…). Collections stay out
      for now. The typed term itself is skipped: "Ver todos" already covers it.
    {%- endcomment -%}
    <div data-search-query-suggestions></div>
      <div id="predictive-search-results-groups-wrapper" class="predictive-search__results-groups-wrapper mb-40 predictive-search__results-groups-wrapper--no-suggestions">
      <div class="predictive-search__result-group">
        {%- if search.results.size > 0 -%}
          <div>
            <span id="predictive-search-products" class="visually-hidden">
              {{- 'templates.search.products' | t -}}
            </span>
            <div
              id="predictive-search-results-products-list"
              class="predictive-search__results-list tp-grid tp-grid--2-col-mobile tp-grid--3-col-tablets tp-grid--{{ numberItemSearch }}-col-desktop"
              role="group"
              aria-labelledby="predictive-search-products">
              {%- for product in search.results limit: 5 -%}
                <div
                  id="predictive-search-option-product-{{ forloop.index }}"
                  data-search-product-id="{{ product.id }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-price="{{ product.selected_or_first_available_variant.price }}" data-compare-price="{{ product.selected_or_first_available_variant.compare_at_price | default: 0 }}" data-available="{{ product.selected_or_first_available_variant.available }}"
                  class="tp-grid__item tp-grid__item-{{ forloop.index }}"
                  role="option"
                  aria-selected="false">
                  {% render 'product-item-layout-1'
                    , card_product: product %}
                </div>
              {%- endfor -%}
            </div>
            {%- comment -%}
              Mobile only (assets/search-modal.css): compact rows so all five results fit,
              even with the keyboard open. Desktop keeps the product cards above.
            {%- endcomment -%}
            <ul class="predictive-search__compact-list list-none" role="group" aria-labelledby="predictive-search-products">
              {%- for product in search.results limit: 5 -%}
                {%- liquid
                  # Same price source and rounding as snippets/product-item-layout-1.liquid
                  assign row_variant = product.selected_or_first_available_variant
                  assign row_price = row_variant.price
                  assign row_compare = row_variant.compare_at_price
                  assign on_sale = false
                  if row_compare != blank and row_compare > row_price
                    assign on_sale = true
                    assign sale_percent = row_compare | minus: row_price | times: 100.0 | divided_by: row_compare | round
                  endif
                -%}
                <li id="predictive-search-option-compact-{{ forloop.index }}" role="option" aria-selected="false" data-search-product-id="{{ product.id }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-price="{{ product.selected_or_first_available_variant.price }}" data-compare-price="{{ product.selected_or_first_available_variant.compare_at_price | default: 0 }}" data-available="{{ product.selected_or_first_available_variant.available }}">
                  <a href="{{ product.url }}" class="predictive-search__compact-link" tabindex="-1">
                    <span class="predictive-search__compact-media">
                      {%- if product.featured_media -%}
                        {{
                          product.featured_media
                          | image_url: width: 128
                          | image_tag: loading: 'lazy', width: 56, height: 56, alt: '', class: 'predictive-search__compact-image'
                        }}
                      {%- endif -%}
                    </span>
                    <span class="predictive-search__compact-info">
                      <span class="predictive-search__compact-title">{{ product.title | escape }}</span>
                      <span class="predictive-search__compact-price">
                        {%- if on_sale -%}
                          <span class="predictive-search__compact-price-sale">{{ row_price | money }}</span>
                          <s class="predictive-search__compact-price-was">{{ row_compare | money }}</s>
                          <span class="predictive-search__compact-badge">-{{ sale_percent }}%</span>
                        {%- else -%}
                          <span>{{ row_price | money }}</span>
                        {%- endif -%}
                        {%- unless row_variant.available -%}
                          <span class="predictive-search__compact-soldout">{{ 'products.product.sold_out' | t }}</span>
                        {%- endunless -%}
                      </span>
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
      </div>
  {%- else -%}
    {%- comment -%} Zero results: say so visibly and offer a next step instead of an empty modal. {%- endcomment -%}
    <div class="predictive-search__empty">
      <p class="predictive-search__empty-title" data-search-empty>{{ 'templates.search.empty_title' | t: terms: search_display }}</p>
      {%- assign empty_chips = settings.qs_listtext | split: ',' -%}
      {%- if settings.qs_show and empty_chips.size > 0 -%}
        <p class="predictive-search__empty-hint">{{ 'templates.search.empty_hint' | t }}</p>
        <ul class="predictive-search__empty-chips list-none" role="list">
          {%- for empty_chip in empty_chips -%}
            {%- assign chip_term = empty_chip | strip -%}
            <li>
              <a href="{{ routes.search_url }}?type=product&q={{ chip_term | url_encode }}&options%5Bprefix%5D=last">
                {{- chip_term -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <div class="predictive-search__empty-actions">
        <a class="predictive-search__assist-link" href="{{ tire_collection_url }}" data-search-tire-link>
          <span class="predictive-search__view-all-text">{{ 'templates.search.empty_tire' | t }}</span>
          {%- render 'icon', icon_name: 'arrow-right' -%}
        </a>
        {%- capture whatsapp_text -%}{{ 'templates.search.whatsapp_message' | t: terms: search_display }}{%- endcapture -%}
        <a
          class="predictive-search__assist-link"
          href="https://wa.me/56977670252?text={{ whatsapp_text | url_encode }}"
          target="_blank"
          rel="noopener">
          <span class="predictive-search__view-all-text">{{ 'templates.search.empty_whatsapp' | t }}</span>
          {%- render 'icon', icon_name: 'arrow-right' -%}
        </a>
      </div>
    </div>
  {%- endif -%}
  </div>

  <span class="hidden" data-predictive-search-live-region-count-value>
    {% liquid
      assign total_results = search.results.size
      if total_results == 0
        echo 'templates.search.no_results' | t: terms: search.terms
      else
        echo 'templates.search.results_with_count' | t: count: total_results | append: ': '
        if search.results.size > 0
          echo 'templates.search.results_products_with_count' | t: count: search.results.size
        endif
      endif
    %}
  </span>
{%- endif -%}

{%- endpaginate -%}
{% schema %}{"name":"Search preview","settings":[]}{% endschema %}
